#!/bin/bash
# accept-preflight —— 验收事实单(M1;**影子运行**)
# ─────────────────────────────────────────────────────────────────────────────
# 权威 : ~/Obsidian/.../raw/提案-机器替代AI替代表-20260829.md §二 M1
# 裁定 : 来信 KB .../议题-来信流水线系统性优化-20260828.md §九(创始人 2026-08-29 02:03:07 拍板)
#
# 🔴 **影子运行** —— M1 未在一张真实片上与验收窗逐项一致之前:
#    本程序的输出 **⛔ 算作替代**,**⛔ 删验收窗的任何动作**。它只出**事实单**,⛔ 出结论。
# 🔴 **三态硬规则**:每行只许 成立 / 不成立 / 未判(硬边界行为 命中 / 未命中 / 未判)。
#    **「未判」必须显式写出并交 AI ⛔ 写成绿或零** —— 判不出就说判不出,是本件存在的理由。
# 🔴 **只拼既有命令 ⛔ 重写判定逻辑**:merge-base / tests/run.sh / git diff / 拆修法复跑。
#
# 用法: accept-preflight <片名> <候选commit> [prompt路径] [--repo <仓路径>] [--report <交付报告>] [--test-cmd <全量命令>]
#       测试入口优先级: --test-cmd > <仓>/11b/test-entry.conf(cmd= / judge=rc|count) > bash tests/run.sh
# 输出: stdout=事实单;证据 tee 到 --evidence-dir(默认 mktemp);退出码 0=事实单已出(⛔ 表示通过)
set -uo pipefail

# 🔴 参数解析:位置参数与旗标**统一在一个循环里取** ⛔ 先 `PROMPT=$3` 再无条件 `shift 3`。
#    2026-08-29 实撞(方案窗口第三十七任跑第 3 步复验时):省略可选的 prompt 直接给 `--repo` ⇒
#    `$3` 把 `--repo` 吃成 prompt 值、`shift 3` 又吃掉仓路径 ⇒ **两个旗标全部失效**。
SLICE=""; CAND=""; PROMPT=""; REPO=""; EVID=""; TESTCMD=""; TESTJUDGE=""; REPORT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --report) REPORT="${2:-}"; shift 2 ;;   # 交付报告(绊线签名的第二个来源;可省)
    --repo) REPO="${2:-}"; shift 2 ;;
    --evidence-dir) EVID="${2:-}"; shift 2 ;;
    --test-cmd) TESTCMD="${2:-}"; shift 2 ;;
    --*) shift ;;
    *)
      if   [ -z "$SLICE"  ]; then SLICE="$1"
      elif [ -z "$CAND"   ]; then CAND="$1"
      elif [ -z "$PROMPT" ]; then PROMPT="$1"; fi
      shift ;;
  esac
done
# 🔴 仓路径判不出就**显式报错** ⛔ 静默退回一个不是 git 仓的路径。
#    旧默认 `dirname($0)/..` 在**发布版**下是 `~/.local/libexec/laixin-lane-releases/`——不是 git 仓,
#    于是基点与全量双双「未判」、1 秒返回,而**那个形态与「真的判不出」在事实单上完全同形**。
#    首火没撞上只因它跑的是仓库里的脚本(那时 `dirname($0)/..` 正好是工具仓)。
#    ⚠️ M1 转正后是从**发布版**调用的 ⇒ 不修这条,转正当天整单全「未判」而没人看得出是坏了。
if [ -z "$REPO" ]; then
  _selfup="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd || true)"
  if [ -n "$_selfup" ] && git -C "$_selfup" rev-parse --git-dir >/dev/null 2>&1; then REPO="$_selfup"
  elif git -C "$PWD" rev-parse --git-dir >/dev/null 2>&1; then REPO="$PWD"
  else
    echo "⛔ 仓路径判不出:本脚本上级($_selfup)不是 git 仓(**从发布版调用时的常态**),当前目录也不是。" >&2
    echo "   请显式传 --repo <仓路径>。⛔ 让本程序静默用一个非仓路径跑——那会出一张整单「未判」的事实单,与「真的判不出」同形。" >&2
    exit 2
  fi
fi
[ -n "$SLICE" ] && [ -n "$CAND" ] || { echo "用法: accept-preflight <片名> <候选commit> [prompt路径] [--repo 仓] [--evidence-dir 目录] [--test-cmd 全量命令]" >&2; exit 2; }
[ -n "$EVID" ] || EVID="$(mktemp -d)"
mkdir -p "$EVID"

TIERS="$REPO/11b/risk-tiers.conf"
VER="$(cd "$REPO" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
CMDLINE="accept-preflight $SLICE $CAND ${PROMPT:-—}"

# ── 隔离:临时 verify worktree + 隔离状态根(HOME 覆盖 ⇒ EV_DIR 随之落到临时目录,
#    绕开 tool-versions 版本账与固定名会话两处全局单例;⛔ 等 T0 ⛔ 加全局锁)──
WT="$(mktemp -d)/wt"
# 🔴 **状态根必须落在 `/Users` 下 ⛔ `mktemp -d`(macOS 落 /var/folders)** —— 2026-08-29 影子第二火实撞:
#    `review-env` 有硬规则「评审 worktree 必须放 /Users 下」(Turbopack 拒绝指向 worktree 外的 node_modules symlink),
#    状态根在 /var/folders ⇒ 该族 10 项全假红。⇒ 隔离要**换位置 ⛔ 换文件系统语义**。
STATE="$HOME/.laixin-m1-state-$$"; mkdir -p "$STATE"
# 🔴 **隔离状态根 ≠ 隔离整个 HOME**(2026-08-29 影子首火实撞:直接 HOME=临时目录 ⇒ vault / 产品仓 /
#    .codex/skills 一并失效,47 项假红 —— `stats` Traceback、产品仓路径变成 /var/folders/…)。
#    ⇒ 只把 `.laixin-*` 状态(含 EV_DIR 的 tool-versions 版本账)留在临时根,**其余顶层条目软链回真身**。
#    这一条是影子运行第一次跑就抓出来的:若当时直接转正,本程序会把合格交付判成 47 项失败。
for _e in "$HOME"/* "$HOME"/.[!.]*; do
  [ -e "$_e" ] || continue
  case "$(basename "$_e")" in .laixin-*) continue ;; esac
  ln -sfn "$_e" "$STATE/$(basename "$_e")" 2>/dev/null || true
done
cleanup(){ git -C "$REPO" worktree remove --force "$WT" >/dev/null 2>&1; rm -rf "$STATE" 2>/dev/null; }
trap cleanup EXIT

BASE="$(git -C "$REPO" rev-parse --short main 2>/dev/null || echo unknown)"
say(){ printf '%s\n' "$*"; }

# ① 基点(既有命令:merge-base --is-ancestor)
r_base="未判"; d_base="候选或 main 解析不出"
if git -C "$REPO" cat-file -e "${CAND}^{commit}" 2>/dev/null; then
  if git -C "$REPO" merge-base --is-ancestor "$CAND" main 2>/dev/null; then
    r_base="成立"; d_base="候选 commit 已是 main 祖先(已合入形态)"
  else
    if git -C "$REPO" merge-base --is-ancestor main "$CAND" 2>/dev/null; then
      r_base="成立"; d_base="候选领先 main 且含其全部历史(可 ff-only)"
    else r_base="不成立"; d_base="候选与 main 已分叉,需 rebase 到 $BASE"; fi
  fi
fi

# ② 全量(既有命令;隔离 worktree + 隔离状态根)
# ── 测试入口**按仓可配**(2026-08-29 方案窗口第三十七任;七步第 3 步在途③)────────────────────
#   原实现把入口(`bash tests/run.sh`)与结果解析(`^结果:N 过 / M 败`)**双双硬编码成工具仓的形态**,
#   于是历史回放跨不到别的仓:钓不钓基座仓无 `tests/run.sh`,其输出是 unittest 风格,两处都对不上。
# 🔴 口径:**让仓自己声明入口与判据 ⛔ 工具替它猜**。优先级 = `--test-cmd` > 仓内 `11b/test-entry.conf` > 回落工具仓形态。
#   `judge=rc` 必须由仓**显式声明**才生效 —— ⛔ 默认「解析不出就看退出码」:那等于把「未判」偷偷变成绿,
#   而三态硬规则里「未判」的存在理由正是**判不出就说判不出**。默认仍是 count(解析不出 ⇒ 未判)。
TESTCONF="$REPO/11b/test-entry.conf"
if [ -z "$TESTCMD" ] && [ -r "$TESTCONF" ]; then
  TESTCMD="$(sed -nE 's/^[[:space:]]*cmd=(.*)$/\1/p' "$TESTCONF" | tail -1)"
  TESTJUDGE="$(sed -nE 's/^[[:space:]]*judge=([a-z]+).*$/\1/p' "$TESTCONF" | tail -1)"
fi
[ -n "$TESTCMD" ] || TESTCMD="bash tests/run.sh"
[ -n "$TESTJUDGE" ] || TESTJUDGE="count"
r_full="未判"; d_full="worktree 建不起来"
if git -C "$REPO" worktree add -f --detach "$WT" "$CAND" >"$EVID/worktree.log" 2>&1; then
  ( cd "$WT" && HOME="$STATE" eval "$TESTCMD" ) >"$EVID/full.log" 2>&1
  rc_full=$?
  line="$(grep -E '^结果:' "$EVID/full.log" | tail -1)"
  p="$(sed -nE 's/^结果:([0-9]+) 过.*/\1/p' <<< "$line")"
  f="$(sed -nE 's/.*\/ ([0-9]+) 败.*/\1/p' <<< "$line")"
  # ── 归态(2026-08-29 修正)────────────────────────────────────────────────────────
  # 🔴 **「不成立」只留给 failed>0 的真红**;其余一切非绿一律 **未判**,并把
  #    `ENTRY_GUARD=` 标记与 `rc` 带进本行。
  #    病灶:原实现在 `judge=rc` 下把 **rc≠0 一律写成「不成立」** —— 于是
  #    「代码真红」与「解释器基线不符 / 找不到 python3 / 入口自己挂了」**在事实单那一行上同形**,
  #    而后者是环境问题、根本没证明代码有问题。仓的入口闸(11b/test-entry.conf)用 rc=90/91
  #    加 `ENTRY_GUARD=` 把这两类分开了,事实单不能又把它们合回去。
  #    ⇒ 失效方向朝「未判」⛔ 朝「不成立」:未判会被 AI 接手看一眼,不成立会被当成打回依据。
  guard="$(grep -m1 '^ENTRY_GUARD=' "$EVID/full.log" 2>/dev/null || true)"
  gver="$(grep -m1 '^ENTRY_VERSION=' "$EVID/full.log" 2>/dev/null || true)"
  gsuf=""; [ -n "$guard" ] && gsuf=";$guard"; [ -n "$gver" ] && gsuf="$gsuf;$gver"
  if [ -n "$p" ] && [ -n "$f" ]; then
    if   [ "$f" -gt 0 ]; then r_full="不成立"; d_full="passed=$p failed=$f rc=$rc_full(**真红**)(入口:$TESTCMD)$gsuf"
    elif [ "$p" -gt 0 ]; then r_full="成立";   d_full="passed=$p failed=$f rc=$rc_full(入口:$TESTCMD)$gsuf"
    else r_full="未判"; d_full="passed=0 failed=0 ⇒ **一个测试都没跑** ⛔ 当绿;rc=$rc_full(入口:$TESTCMD)$gsuf"; fi
  elif [ "$TESTJUDGE" = rc ] && [ "$rc_full" -eq 0 ]; then
    # 仓显式声明按退出码判(unittest / pytest 等框架保证 rc 语义)⇒ 才允许无计数也定绿。
    r_full="成立"; d_full="rc=0(仓声明 judge=rc;无过/败计数)(入口:$TESTCMD)$gsuf"
  elif [ "$TESTJUDGE" = rc ]; then
    r_full="未判"
    d_full="rc=${rc_full}≠0 但**无过/败计数** ⇒ 分不出真红与环境失败 ⇒ 未判 ⛔ 写不成立;入口:$TESTCMD$gsuf;末行:$(tail -1 "$EVID/full.log" | cut -c1-80)"
  else
    r_full="未判"
    d_full="解析不出「结果:N 过 / M 败」且仓未声明 judge=rc ⇒ 未判(⛔ 当绿);rc=$rc_full;入口:$TESTCMD$gsuf;末行:$(tail -1 "$EVID/full.log" | cut -c1-80)"
  fi
fi

# ③ 硬边界扫描(既有命令:git diff --name-only / --stat × 配置文件禁止路径集)
r_edge="未判"; d_edge="risk-tiers.conf 读不到 ⇒ 禁止路径集无来源"
git -C "$REPO" diff --stat "$BASE...$CAND" >"$EVID/diff.stat" 2>/dev/null
if [ -f "$TIERS" ]; then
  git -C "$REPO" diff --name-only "$BASE...$CAND" >"$EVID/diff.files" 2>/dev/null
  cpaths="$(sed -n '/^\[C_PATHS\]/,/^\[/p' "$TIERS" | grep -vE '^\[|^#|^$')"
  hit=""
  while IFS= read -r pat; do
    [ -n "$pat" ] || continue
    while IFS= read -r fp; do
      [ -n "$fp" ] || continue
      case "$fp" in ${pat//\*\*/*}) hit="$hit $fp($pat)" ;; esac
    done < "$EVID/diff.files"
  done <<< "$cpaths"
  if [ -n "$hit" ]; then r_edge="命中"; d_edge="C_PATHS:$hit"; else r_edge="未命中"; d_edge="C_PATHS 零命中(⛔ 读成语义边界也干净——语义边界归验收 AI 四问之三)"; fi
fi
if [ -z "${PROMPT:-}" ] || [ ! -f "${PROMPT:-/nonexistent}" ]; then
  r_edge="未判"; d_edge="prompt 边界段无机读路径(未给 prompt 或文件不存在)⇒ 该项未判 ⛔ 当未命中"
fi

# ④ 绊线 · 拆修法复跑(2026-08-29 由「只解析签名」补为实做;替代表 M1 ② 绊线行)
# ─────────────────────────────────────────────────────────────────────────────
# 做法:**只叠 tests 改动**到最终 main 基点的隔离 worktree 上,跑仓自己声明的入口,
#   看点名的那个回归测试是不是**以断言失败**变红;再看它在候选上绿。两边都对才叫成立。
# 🔴 **「变红」⛔ 一律算绊线成立**(v0.2 修订 3 原话:任意变红 ⛔ 算绊线成立):
#   收集错误 / 语法错误 / 环境错误 / 别的测试也红 —— 每一种都会让套件变红,而它们
#   **一个都没证明「这条断言真的守住了那个缺陷」**。⇒ 这四类一律 **未判并写明哪一类**。
# 🔴 **⛔ 改写开发分支 ⛔ 碰共享版本账**:另开一个 detach 到 BASE 的临时 worktree,
#   HOME 仍指隔离状态根;patch 只取 `tests/` 路径面。
# 🔴 **⛔ 自造签名**:签名必须同时满足两条 —— 在 prompt/交付报告里被**逐字点名**,
#   且**出现在本分支的 tests 改动里**。只满足前一条(片名里恰好有个 test_ 词、或点名了一个
#   本分支根本没动的老测试)⇒ 未判,⛔ 拿一个没被这一片碰过的测试去当绊线。
r_trip="未判"; d_trip="无预期失败签名(prompt/交付报告未点名回归测试 id)⇒ 未判 ⛔ 当绿"
# 🔴 **⑤ `--report` 可省,但 ⛔ 可省且静默**:旧版省了就只读 prompt,事实单上**看不出少读了一半**
#   ——「报告没提签名」与「压根没读报告」在单子上完全同形(值守第 12 次自认实撞)。
#   ⇒ 省略时**按片名推导**记录目录里的交付报告,并把**来源逐字写进事实单**(推导 / 显式 / 读不到 / 不存在)。
#   ⛔ 改成必填:既有调用方(tests/run.sh 的 6 条)本来就不带 --report,必填会把「本来就没有报告」
#   这一类正当用法一起打死。
SRCTXT="$EVID/sigsrc.txt"; : > "$SRCTXT"
sig_src=""
if [ -n "${PROMPT:-}" ]; then
  if [ -f "$PROMPT" ]; then cat "$PROMPT" >> "$SRCTXT" 2>/dev/null; sig_src="prompt=${PROMPT}"
  else sig_src="prompt=${PROMPT}(**读不到**)"; fi
fi
RECDIR="${LAIXIN_RECORDS_DIR:-$HOME/Obsidian/项目入口/来信平台/知识库/4-开发层/记录}"
if [ -n "${REPORT:-}" ]; then
  if [ -f "$REPORT" ]; then cat "$REPORT" >> "$SRCTXT" 2>/dev/null
    sig_src="${sig_src:+${sig_src};}报告=显式给定 ${REPORT}"
  else sig_src="${sig_src:+${sig_src};}报告=显式给定但**读不到** ${REPORT}"; fi
else
  REPGUESS="${RECDIR}/$(printf '%s' "$SLICE" | tr ':' '-')-交付报告.md"
  if [ -f "$REPGUESS" ]; then cat "$REPGUESS" >> "$SRCTXT" 2>/dev/null; REPORT="$REPGUESS"
    sig_src="${sig_src:+${sig_src};}报告=**按片名推导**(⛔ 显式给定)${REPGUESS}"
  else
    sig_src="${sig_src:+${sig_src};}报告=未给 --report,按片名推导的 ${REPGUESS} **不存在** ⇒ 本单签名只来自 prompt"
  fi
fi
[ -n "$sig_src" ] || sig_src="prompt 与交付报告**都没有** ⇒ 签名零来源"
trip_run(){ # trip_run <树> <日志>  —— 用仓声明的同一个入口,⛔ 另造跑法
  ( cd "$1" && HOME="$STATE" eval "$TESTCMD" ) > "$2" 2>&1; echo $?
}
trip_verdict(){ # trip_verdict <日志> <签名> → ok|FAIL|ERROR|absent
  local g; g="$(grep -E "(^|[^A-Za-z0-9_])$2([^A-Za-z0-9_]|\$)" "$1" 2>/dev/null | grep -oE '\.\.\. (ok|FAIL|ERROR)' | tail -1 || true)"
  case "$g" in *ok) echo ok ;; *FAIL) echo FAIL ;; *ERROR) echo ERROR ;; *) echo absent ;; esac
}
if [ -s "$SRCTXT" ] && grep -qE '绊线不适用|非缺陷片' "$SRCTXT"; then
  r_trip="未判"
  d_trip="**不适用**(prompt/报告逐字声明「绊线不适用/非缺陷片」)⇒ 本行按三态硬规则记未判并写明不适用 ⛔ 新造第四态"
elif [ -s "$SRCTXT" ]; then
  git -C "$REPO" diff "$BASE...$CAND" -- tests/ > "$EVID/tests.patch" 2>/dev/null || true
  if [ ! -s "$EVID/tests.patch" ]; then
    d_trip="本分支 tests/ 零改动 ⇒ 没有可叠的绊线 ⇒ 未判 ⛔ 当绿"
  else
    # 🔴 **①② 候选 = 被逐字点名 ∩ 本分支 tests 三点 diff 里真有 `def <名>(`**。
    #   ⛔ `grep -qF "<名>" tests.patch` —— diff 头的 `+++ b/tests/<名>.py` 会让**模块名**整包命中,
    #   而模块名在报告里恰恰**排在真函数名前面**(先写路径再写函数)⇒ 它夺魁并压过全部真函数。
    #   实撞(2026-08-29 值守 M1 第四组,候选 19e2abfe):`test_production_wsgi` 在 patch 里
    #   `def` 数为 **0** 却被选中,压过 2 个新增 def 与 1 个既有 def,拆修法复跑被无关红搅浑 ⇒ 未判。
    # 分档:**新增的 def**(本片真正立起来的绊线)> **既有 def**(本片碰了文件但没新立这条)。
    #   ⛔ 让既有 def 与新增 def 同档竞争:那等于允许「拿一条本片没立的断言去当绊线」。
    _def_in(){ grep -qE "^[+ ][[:space:]]*(async[[:space:]]+)?def[[:space:]]+${1}[[:space:]]*\\(" "$EVID/tests.patch"; }
    _def_added(){ grep -qE "^\\+[[:space:]]*(async[[:space:]]+)?def[[:space:]]+${1}[[:space:]]*\\(" "$EVID/tests.patch"; }
    # 抽词:报告里的签名是 **`模块.类.方法` 点分 unittest id**(真报告实测形态),
    #   老代码 `grep -oE 'test_[A-Za-z0-9_]{3,}'` 在**同一个 token 内**先扫到**模块段**
    #   ⇒ 模块名天然排在真方法名前面,再被 `grep -qF` 在 diff 头的文件名上放行 ⇒ 夺魁。
    #   ⇒ 连**前后各一个邻字符**一起抓,用它判这个词是不是点分 id 的**叶子**:
    #     后邻是 `.` 或 `/` ⇒ 后面还有段,它是模块/包/目录 ⛔ 方法(`.py` 亦归此类);
    #     前邻是 `/` ⇒ 它是路径里的文件名。
    #   判权仍归 ①(patch 里有没有 `def <名>(`):② 只负责**给落选理由**。
    #   ⛔ 让 ② 先斩:万一某文件里真有同名 `def`,那它就是条真测试,该用。
    sig_add=""; sig_ctx=""; sig_rej=""; seen_names=" "
    while IFS= read -r raw; do
      [ -n "$raw" ] || continue
      pre="${raw%%test_*}"; pre="${pre: -1}"
      rest="test_${raw#*test_}"
      case "$rest" in
        *[!A-Za-z0-9_]) post="${rest: -1}"; nm="${rest%?}" ;;
        *) post=""; nm="$rest" ;;
      esac
      [ -n "$nm" ] || continue
      case "$seen_names" in *" ${nm} "*) continue ;; esac
      seen_names="${seen_names}${nm} "
      if _def_added "$nm"; then sig_add="${sig_add:+${sig_add} }${nm}"
      elif _def_in "$nm"; then sig_ctx="${sig_ctx:+${sig_ctx} }${nm}"
      elif [ "$post" = "." ] || [ "$post" = "/" ]; then
        sig_rej="${sig_rej:+${sig_rej} · }${nm}(**模块/包段**:后面还接着 \`${post}\`,是 id 的非叶子段,且 patch 内无 def)"
      elif [ "$pre" = "/" ]; then
        sig_rej="${sig_rej:+${sig_rej} · }${nm}(**路径里的文件名**,patch 内无 def)"
      else
        sig_rej="${sig_rej:+${sig_rej} · }${nm}(patch 内无 def:本片没动它,或是别片的测试)"
      fi
    done <<< "$(grep -oE '.?test_[A-Za-z0-9_]{3,}.?' "$SRCTXT" | awk '!seen[$0]++')"
    if [ -z "$sig_add" ] && [ -z "$sig_ctx" ]; then
      # ④ 候选为空 ⇒ 未判并写明是哪一种空
      d_trip="**无真实函数签名**(报告/prompt 只提及模块名,或点的是别片测试)⇒ 未判 ⛔ 拿没被本片碰过的测试当绊线。签名来源:${sig_src}。落选逐条:${sig_rej:-无任何 test_ 词}"
    else
      if [ -n "$sig_add" ]; then sig="${sig_add%% *}"; sig_why="本分支 tests 改动里**新增**的 def"
      else sig="${sig_ctx%% *}"; sig_why="patch 内**既有** def(本片碰了该文件但未新增此条;⛔ 新增档为空才退到这里)"; fi
      # ③ 多候选 ⇒ 写明为何选它、其余为何未选(⛔ 只列候选)
      _rest_add="${sig_add#"$sig"}"; _rest_add="${_rest_add# }"
      sig_rest=""
      [ -n "$_rest_add" ] && sig_rest="新增档另有 ${_rest_add}(同档,按点名先后取第一个)"
      if [ -n "$sig_add" ] && [ -n "$sig_ctx" ]; then
        sig_rest="${sig_rest:+${sig_rest};}既有档 ${sig_ctx}(**低一档**,新增档非空故未选)"
      elif [ -z "$sig_add" ]; then
        _rest_ctx="${sig_ctx#"$sig"}"; _rest_ctx="${_rest_ctx# }"
        [ -n "$_rest_ctx" ] && sig_rest="${sig_rest:+${sig_rest};}既有档另有 ${_rest_ctx}"
      fi
      [ -n "$sig_rej" ] && sig_rest="${sig_rest:+${sig_rest};}落选 ${sig_rej}"
      sig_rest="${sig_rest:+${sig_rest};}签名来源 ${sig_src}"
      WT2="$(mktemp -d)/base"
      if ! git -C "$REPO" worktree add -f --detach "$WT2" "$BASE" >"$EVID/base-worktree.log" 2>&1; then
        d_trip="签名=${sig}(**选它**:${sig_why})${sig_rest:+;${sig_rest}};基点隔离 worktree 建不起来 ⇒ 未判(**环境错误**)"
      elif ! git -C "$WT2" apply "$EVID/tests.patch" >"$EVID/tests-apply.log" 2>&1; then
        d_trip="签名=${sig}(**选它**:${sig_why})${sig_rest:+;${sig_rest}};tests 改动**叠不到基点上**(git apply 失败)⇒ 未判(**环境错误**);见 tests-apply.log"
      else
        rc_base="$(trip_run "$WT2" "$EVID/base+tests.log")"
        v_base="$(trip_verdict "$EVID/base+tests.log" "$sig")"
        v_cand="$(trip_verdict "$EVID/full.log" "$sig")"
        # 🔴 `grep -c` **零命中时既打印 0 又返回 1**(AGENTS「grep -c 零命中退出码 1 要兜底」)。
        #   兜底必须是 `|| true` ⛔ `|| echo 0` —— 后者会在已打印的 0 后面**再追一行 0**,
        #   变量里带上换行 ⇒ `[ "$n" -gt 0 ]` 报 integer expression expected 并**静默判假**,
        #   同时把整条 d_trip 在事实单上截断。本行首版实撞过一次(2026-08-29),故留此注。
        nfail="$(grep -cE '\.\.\. FAIL$|\.\.\. FAIL ' "$EVID/base+tests.log" 2>/dev/null || true)"
        nerr="$(grep -cE '\.\.\. ERROR$|\.\.\. ERROR ' "$EVID/base+tests.log" 2>/dev/null || true)"
        nfail="${nfail:-0}"; nerr="${nerr:-0}"
        d_common="签名=${sig}(**选它**:${sig_why})${sig_rest:+;${sig_rest}};基点+tests rc=$rc_base 该测试=$v_base(全树 FAIL=$nfail ERROR=$nerr);候选上该测试=$v_cand"
        if [ "$v_base" = absent ]; then
          r_trip="未判"; d_trip="$d_common ⇒ 点名的测试在基点+tests 树上**跑不到** ⇒ 未判(**收集错误**)"
        elif [ "$v_base" = ERROR ] || [ "$nerr" -gt 0 ]; then
          r_trip="未判"; d_trip="$d_common ⇒ 变红是 **ERROR(收集/语法/环境错误)⛔ 断言失败** ⇒ 未判"
        elif [ "$v_base" = ok ]; then
          r_trip="不成立"; d_trip="$d_common ⇒ **不拆也绿**:把修法拿掉后该断言仍然通过 ⇒ 它没守住那个缺陷"
        elif [ "$nfail" -gt 1 ]; then
          # 🔴 **收窄(2026-08-29 调度 pingxia-47 批准并入 5.1b;⛔ 议题 8)**:替代表 ② 原文是
          #   「…**别的**测试红 ⇒ 未判」。**本片自己新增的 def 不是「别的测试」** —— 一片立两条绊线
          #   在旧规则下必然撞 nfail>1 而被判未判(实撞 19e2abfe:两条红恰是本片新增的两条)。
          #   新判据:红条集合 ⊆ 本片 tests 三点 diff **新增**的 def 集合 ∧ 每条在基点以**断言失败**红
          #   ∧ 每条在候选上绿 ⇒ **成立(多绊线,逐条列名)**;任一红条 ∉ 新增集合 ⇒ 未判「归因不唯一
          #   (无关红:名)」;任一红条是收集/语法/环境错误 ⇒ 未判「非断言红:名」。
          #   ⛔ 放宽成「红得多也算成立」:名字必须逐条对得上**本片新增**的那几条,⛔ 只数个数。
          grep -oE '^\+[[:space:]]*(async[[:space:]]+)?def[[:space:]]+test_[A-Za-z0-9_]+' "$EVID/tests.patch" \
            | sed -E 's/.*def[[:space:]]+//' | awk '!seen[$0]++' > "$EVID/added-defs.txt" || true
          grep -E '^[A-Za-z0-9_]+ .*\.\.\. (FAIL|ERROR)([^A-Za-z]|$)' "$EVID/base+tests.log" 2>/dev/null \
            | sed -E 's/^([A-Za-z0-9_]+) .*\.\.\. (FAIL|ERROR).*$/\1 \2/' | awk '!seen[$0]++' > "$EVID/reds.txt" || true
          red_alien=""; red_nonassert=""; red_names=""; red_notgreen=""
          while read -r rname rkind; do
            [ -n "$rname" ] || continue
            red_names="${red_names:+${red_names} }${rname}"
            [ "$rkind" = FAIL ] || red_nonassert="${red_nonassert:+${red_nonassert} }${rname}(${rkind})"
            grep -qxF "$rname" "$EVID/added-defs.txt" || red_alien="${red_alien:+${red_alien} }${rname}"
            [ "$(trip_verdict "$EVID/full.log" "$rname")" = ok ] || red_notgreen="${red_notgreen:+${red_notgreen} }${rname}"
          done < "$EVID/reds.txt"
          if [ -z "$red_names" ]; then
            r_trip="未判"; d_trip="$d_common ⇒ 计数说 FAIL=$nfail 却**一条红的名字都抽不出来**(日志形态不认识)⇒ 未判 ⛔ 当成立"
          elif [ -n "$red_nonassert" ]; then
            r_trip="未判"; d_trip="$d_common ⇒ **非断言红**:${red_nonassert} ⇒ 未判(收集/语法/环境错误 ⛔ 算绊线守住)"
          elif [ -n "$red_alien" ]; then
            r_trip="未判"; d_trip="$d_common ⇒ **归因不唯一(无关红:${red_alien})** —— 它们不在本片 tests 改动新增的 def 集合里 ⇒ 未判"
          elif [ -n "$red_notgreen" ]; then
            r_trip="未判"; d_trip="$d_common ⇒ 红条 ${red_notgreen} 在**候选上并非 ok** ⇒ 未判 ⛔ 只凭基点侧变红就判成立"
          else
            r_trip="成立"; d_trip="$d_common ⇒ **多绊线**:基点+tests 上恰好红的 ${nfail} 条(${red_names})**全部**是本片新增的 def、且**全部**以断言失败红、在候选上**全部**绿 ⇒ 拆修法复跑通过"
          fi
        elif [ "$v_cand" != ok ]; then
          r_trip="未判"; d_trip="$d_common ⇒ 该测试在**候选上并非 ok** ⇒ 未判 ⛔ 只凭基点侧变红就判成立"
        else
          r_trip="成立"; d_trip="$d_common ⇒ 基点+tests **恰这一条以断言失败变红**、候选上绿 ⇒ 拆修法复跑通过"
        fi
        git -C "$REPO" worktree remove --force "$WT2" >/dev/null 2>&1 || true
      fi
    fi
  fi
fi

# ── 事实单 ──
{
say "候选 commit: $CAND"
say "最终 main 基点: $BASE"
say "运行命令: $CMDLINE"
say "程序版本: accept-preflight@$VER (影子运行)"
say "退出码: 见各行"
say "证据路径: $EVID"
say ""
say "基点: $r_base — $d_base"
say "全量: $r_full — $d_full"
say "硬边界: $r_edge — $d_edge"
say "绊线: $r_trip — $d_trip"
# 证据行 ⛔ 无条件列出:diff.files 仅在 risk-tiers.conf 存在时才写(见 ③),
# full.log 仅在 worktree 建起来时才写(见 ②)。无条件列 ⇒ 事实单指向一个不存在的文件,
# 而「本次没产出该证据」与「证据被删了」在该行上同形 —— 正是本单其余各行极力避免的那种同形。
_ev=""; _ev_absent=""
for _f in full.log diff.stat diff.files worktree.log; do
  if [ -f "$EVID/$_f" ]; then
    [ -n "$_ev" ] && _ev="$_ev · "
    _ev="$_ev$EVID/$_f"
  else
    _ev_absent="$_ev_absent $_f"
  fi
done
say "证据: ${_ev:-(本次零证据文件)}"
[ -n "$_ev_absent" ] && say "本次未生成:$_ev_absent(⛔ 读成被删——缺因见上方对应行的未判理由)"
say ""
say "⚠️ 影子运行:本单 ⛔ 算替代 ⛔ 删验收窗动作;任一行「未判」须由验收窗自判并写进回执。"
say "【验收事实单】$SLICE $CAND $BASE"
} | tee "$EVID/factsheet.txt"
exit 0
