#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""judge-scan —— 判据扫描器(每条判据=一个扫描器;定位=**防回归** ⛔ 清存量)

权威清单:11B raw/程序-AI配合问题-采集与分析-20260829.md **§十**(值守线维护 ⛔ 本脚本改)。
来历:创始人 2026-08-29 令「**后面让机器程序来替代这些任务的监控**」。
首行依据:「刚写完或刚引用某条判据的人,在下一个动作里违反它」当日 **8 次 / 4 个主体**
—— **判据靠人执行不可靠**。

## 三条硬前置(例49,写死)

1. 每条扫描器**配阳性/阴性夹具进 tests**;阴性=已知正确写法**必须不报**。
2. 报告**可追到文件与行** ⛔ 只给计数。
3. 判不了的**显式写「未判(原因)」** ⛔ 静默略过 —— 一条判据「没实现」与「扫过没事」
   在输出面必须**不同形**。

## 两条从 J9 三轮收窄学来的(比 J9 本身值钱)

- **扫描器须匹配「输出流向」⛔ 只匹配语法**:同一句 `git show HEAD:<f>` 写进发布目录是**对的**,
  拿去比对作闸才是错的。
- **每轮收窄后必须重验阴性面**:任何一轮直接交付,上线当天就会误报。

## 定位

**防回归**:挂 `tests/run.sh` 作闸,**新增位置即红**;已知存量由 `--baseline` 放行,各归其件。
⛔ 用「扫出多少存量」当有效性判据 —— 清单里本就会有当刻零存量的条目。

退出码:**有新增阳性 1 · 无 0 · 扫描器自身异常 2**。

## 只装 A 类(pingxia-47 2026-08-29 补裁)

**A 类 = 输入是当前代码、输出是违反位置**(「**这里违反了,去改**」)⇒ 共用一套夹具与报告格式,
挂 tests 闸。**B 类 = 动作前判定**(「**这次动作能不能这么做**」,如 J10:给定 diff 判能否沿用
测试读数)⇒ **独立子命令 ⛔ 挂 tests 闸**,报告格式与 A 类分开,排首批之后。
两类混在一个报告里,读的人会把「去改代码」和「这次别这么做」当成同一件事。

🔴 **套件封闭性(硬规则)**:扫描器与夹具 **⛔ 读真环境**。J3 因要读真实 `~/.claude-official`
被移出本件、归 doctor —— 非封闭源一旦进套件,测试结果就随本机状态漂移。
"""

import hashlib
import io
import os
import re
import sys

# ── 射程(默认;J3/J8 这类须显式列举对象的判据 ⛔ 扫全目录)────────────────────────
SCOPE_DIRS = ("bin",)
SCOPE_FILES = ("tests/run.sh", "contrib-statusline.py")
SKIP_SUFFIX = (".pyc",)
# 🔴 **扫描器自己不进射程**:它的正则**与解释文字里的样例**都写着要找的那个形态,
#   扫自己必然自命中(首跑实撞:J7 命中本文件的说明字符串、J1 同理)。
#   ⚠️ 这是**真的射程缺口**,按硬前置③ 在输出的「未判」段显式写出来 ⛔ 假装覆盖。
SELF_EXCLUDE = ("bin/judge-scan",)

PY_SUFFIX = (".py",)
PY_EXTRA = ("bin/replay-six", "bin/handover-lint", "bin/judge-scan")   # 无 .py 后缀的 python

# 本批**未实现**的条目:必须在输出里列出来 ⛔ 静默缺席(硬前置③)。
NOT_IMPLEMENTED = [
    ("J3", "effective-path-on-release",
     "**不做,归 doctor**(pingxia-47 2026-08-29 补裁):它要读真实 `~/.claude-official` 环境,"
     "进 tests 会引入**非封闭源** —— 套件封闭性是硬规则(扫描器与夹具 ⛔ 读真环境)"),
    ("J5", "stuck-detector-required",
     "清单标**未判** —— 需语义理解;近似做法须先证明阴性面干净,当刻未证"),
    ("J6", "—",
     "清单标**不可机械** —— 判的是人的动作(下结论前先实核),不是代码形态"),
    ("J8", "append-newline-guarded",
     "当刻跳过:阴性样本是「2.3 落地后的写法」,2.3 未落地 ⇒ **阴性不存在**,硬做无法证明不误报"),
]


class ScanError(Exception):
    pass


def is_comment(line):
    return line.lstrip().startswith("#")


def read_lines(path):
    with io.open(path, "r", encoding="utf-8", errors="replace") as fh:
        return fh.read().split("\n")


def norm(text):
    return re.sub(r"\s+", " ", text).strip()


def fingerprint(jid, rel, text):
    return "%s\t%s\t%s" % (jid, rel, hashlib.sha1(norm(text).encode("utf-8")).hexdigest()[:12])


def iter_files(repo):
    out = []
    for d in SCOPE_DIRS:
        p = os.path.join(repo, d)
        if not os.path.isdir(p):
            continue
        for name in sorted(os.listdir(p)):
            f = os.path.join(p, name)
            if not os.path.isfile(f) or name.endswith(SKIP_SUFFIX):
                continue
            if os.path.relpath(f, repo) in SELF_EXCLUDE:
                continue
            out.append(f)
    for rel in SCOPE_FILES:
        f = os.path.join(repo, rel)
        if os.path.isfile(f):
            out.append(f)
    return out


def is_python(repo, path):
    rel = os.path.relpath(path, repo)
    return path.endswith(PY_SUFFIX) or rel in PY_EXTRA


# ── J1 ────────────────────────────────────────────────────────────────────────
# `grep -c` 不带 `-a`:含 NUL 的文件被判为二进制 ⇒ 打印「Binary file … matches」**而非计数**,
# 读数静默失真(例9 / 例26)。阴性:带 `-a` 的写法 · **注释行里的写法**。
J1_RE = re.compile(r"\bgrep\s+((?:-[A-Za-z-]+\s+)*)-([A-Za-z]*c[A-Za-z]*)\b")


def scan_j1(repo, path, lines):
    hits = []
    for i, ln in enumerate(lines, 1):
        if is_comment(ln):
            continue
        for m in J1_RE.finditer(ln):
            pre, cluster = m.group(1) or "", m.group(2)
            if "a" in cluster or re.search(r"-[A-Za-z-]*a", pre):
                continue
            hits.append((i, m.group(0),
                         "`grep -c` 不带 `-a`:含 NUL 的文件会被判为二进制 ⇒ 打印「Binary file matches」"
                         "而不是计数,读数**静默失真**"))
    return hits


# ── J2 ────────────────────────────────────────────────────────────────────────
# `[ -L x ]` 只测「是不是软链」,终点的存在性/身份一概不核:断链 · 终点空目录 · 指错目标
# **三种失效全报绿**(例22)。阴性:修后的 doctor §1(核了 `-f` 与 `-ef`)。
# ⚠️ **窗口必须先剔除注释行**,否则注释会把核终点的代码挤出窗口(例49 实撞)。
# ⚠️ **第二轮收窄(同刻对照实撞)**:第一版只问「窗口里有没有 `-f`/`-d`/`readlink`」,
#   于是**另一个路径**的检查也算数 ⇒ 例22 修前那行(`if [ -L "$eff/skills/$sk" ]; then ok "已软链"`,
#   其后紧跟的是对 `$HOME/.claude/skills/$sk` 的 `-d`)被判**绿** —— 扫描器抓不到它本来要防的那个案例。
#   ⇒ 证据必须**指向同一个路径**:窗口里要出现**该路径本身(或它的子路径)**且带核终点的算子。
J2_RE = re.compile(r'''\[\[?\s+-L\s+("[^"]*"|'[^']*'|\S+)''')
J2_OP = re.compile(r"readlink|\brealpath\b|\bstat\b|-ef\s|\[\s*!?\s*-[efdrsx]\s")
J2_WINDOW = 6


def scan_j2(repo, path, lines):
    hits = []
    for i, ln in enumerate(lines, 1):
        if is_comment(ln):
            continue
        m = J2_RE.search(ln)
        if not m:
            continue
        target = m.group(1).strip('"\'')
        # ⚠️ **第三轮收窄(同刻对照第二次实撞)**:窗口若吃进 `elif` / `else` 分支,
        #   例22 修前那处的 `elif [ -d "$eff/skills/$sk" ]`(**否定分支**,不是核终点)
        #   会被当成证据 ⇒ 仍判绿。⇒ 窗口**止于同层的 elif/else/fi/esac/done**。
        window, j = [], i          # lines[i] 是下一行(0 基)
        while j < len(lines) and len(window) < J2_WINDOW:
            cur = lines[j]
            if not is_comment(cur):
                if re.match(r"\s*(elif\b|else\b|fi\b|esac\b|done\b)", cur):
                    break
                window.append(cur)
            j += 1
        checked = False
        for w in [ln[m.end():]] + window:
            if target in w and J2_OP.search(w):
                checked = True
                break
        if not checked:
            hits.append((i, norm(ln),
                         "`-L` 之后未见**对同一路径**核终点(存在性/身份):断链 · 终点空目录 · 指错目标"
                         "**三种失效都会报绿**,而后果与「软链不存在」相同"))
    return hits


# ── J4 ────────────────────────────────────────────────────────────────────────
# 裸 `except` 静默吞:异常被吃掉且**装作正常**(例30)。阴性=except 之后有输出。
# ⚠️ **收窄(首跑实撞)**:第一版扫所有 `except ...:`,把 `except IOError: continue` 这类
#   **带类型的正常控制流**报了 4 处(全是假阳性)。判据原文是「**裸** `except` 不许静默吞」,
#   阳性=例30 的 `except:` 之后 `pass` ⇒ 只认**无类型**与**全捕获**两形。
J4_RE = re.compile(r"^(\s*)except\s*(\(?\s*(Exception|BaseException)\s*\)?(\s+as\s+\w+)?)?\s*:\s*(#.*)?$")
J4_OUTPUT = re.compile(r"print\(|sys\.stderr|write\(|logging|log\.|raise|die\(|warn|sys\.exit")


def scan_j4(repo, path, lines):
    if not is_python(repo, path):
        return []
    hits = []
    for i, ln in enumerate(lines, 1):
        m = J4_RE.match(ln)
        if not m:
            continue
        indent = len(m.group(1))
        body, j = [], i
        while j < len(lines):
            cur = lines[j]
            if cur.strip() == "":
                j += 1
                continue
            cur_indent = len(cur) - len(cur.lstrip())
            if cur_indent <= indent:
                break
            body.append(cur)
            j += 1
        if not body:
            continue
        if J4_OUTPUT.search("\n".join(body)):
            continue
        meaningful = [b for b in body if not b.lstrip().startswith("#")]
        if meaningful and all(re.match(r"\s*(pass|continue|break|return(\s+None)?)\s*$", b)
                              for b in meaningful):
            hits.append((i, norm(ln) + " ⇒ " + norm(meaningful[0]),
                         "裸 `except` 之后只有 pass/continue/return 且**零输出** ⇒ 异常被吃掉并**装作正常**"))
    return hits


# ── J7 ────────────────────────────────────────────────────────────────────────
# `[ -d <path>/.git ]` 判「是不是 git 仓」:**worktree 的 `.git` 是文件不是目录**
# ⇒ 对 worktree 一律判「不是仓」(例7)。阴性:`git -C <p> rev-parse --git-dir` 这类既认目录也认文件的写法。
J7_RE = re.compile(r"-d\s+\"?[^\"\s]*?/\.git\"?")


def scan_j7(repo, path, lines):
    hits = []
    for i, ln in enumerate(lines, 1):
        if is_comment(ln):
            continue
        m = J7_RE.search(ln)
        if m:
            hits.append((i, norm(ln),
                         "用 `-d <path>/.git` 判仓:**worktree 的 `.git` 是文件不是目录** ⇒ worktree "
                         "一律被判成「不是 git 仓」;改用 `git -C <p> rev-parse --git-dir`"))
    return hits


# ── J9 ────────────────────────────────────────────────────────────────────────
# 「发布物 vs 仓内」的断言**基准须与 checkout 无关**:⛔ 比 `HEAD:<file>`(例50)。
# 🔴 **三层收窄**(清单实测三轮才对;每轮都要重验阴性面):
#   一层 只扫 `git show HEAD:` ⇒ 报 6 处,其中 **4 处是 release 动作本身**(从 HEAD 取内容
#         **写进发布目录**,是**正确写法**)⇒ 假阳性;
#   二层 收窄到「输出被 cmp / diff」⇒ 排掉那 4 处,剩 2 处;
#   三层 按有无 die 判闸 ⇒ **仍错**:**在 `tests/` 之下,任何断言失败都是闸**(测试红 ⇒ 合并闸不过),
#         **不看有没有 die**。
# ⇒ 判据 = 「输出被比对」∧「位于 tests/」。
# ⚠️ **已知射程缺口(显式写出来 ⛔ 假装覆盖)**:`bin/` 里同样比 HEAD 的 `release_stale`
#   是**提示**不是闸(清单列为阴性),而「提示 vs 闸」需语义 ⇒ 本扫描器**不判 bin/ 侧**。
#   若将来 bin/ 里出现一处比 HEAD 的**硬闸**,本扫描器**看不见** —— 这一条按硬前置③ 显式报「未判」。
# ⚠️ **首跑漏报**:原写 `-C\s+\S+`,而真阳性那行是 `-C "$(dirname "$2")/.."`(**带空格**)⇒ 漏掉。
#   ⇒ 放宽成「同一行里 git … show … HEAD:」,收窄交给下面两层(是否被比对 · 是否在 tests/)。
J9_RE = re.compile(r"\bgit\b[^\n]*?\bshow\b[^\n]*?HEAD:")
J9_COMPARE = re.compile(r"\|\s*(diff|cmp)\b|\b(diff|cmp)\s+[-\S]*\s*-\s")
J9_WINDOW = 4


def scan_j9(repo, path, lines):
    rel = os.path.relpath(path, repo)
    hits = []
    for i, ln in enumerate(lines, 1):
        if is_comment(ln) or not J9_RE.search(ln):
            continue
        blob = ln + "\n" + "\n".join(
            l for l in lines[i:i + J9_WINDOW] if not is_comment(l))
        if not J9_COMPARE.search(blob):
            continue                        # 二层:输出没被比对(多半是取内容写进发布目录)
        if not rel.startswith("tests" + os.sep):
            continue                        # 三层:bin/ 侧「提示 vs 闸」需语义,见上方缺口说明
        hits.append((i, norm(ln),
                     "拿 `HEAD:<file>` 当发布一致性的基准并**在 tests/ 下作闸**:`HEAD` 随 checkout 变,"
                     "基准就不再与发布物对应;应比**自称 sha 的已提交版**且核该 sha 属 main 历史"))
    return hits


SCANNERS = [
    ("J1", "grep-a-required", scan_j1),
    ("J2", "symlink-target-checked", scan_j2),
    ("J4", "no-silent-except", scan_j4),
    ("J7", "git-repo-detect", scan_j7),
    ("J9", "release-baseline-invariant", scan_j9),
]

UNJUDGED_RUNTIME = [
    ("—", "**夹具文本与真代码在行级扫描下同形**:`tests/` 里为演示坏写法而写的夹具字符串"
          "会被计为阳性,由基线放行;新增此类夹具会误红 ⇒ 需重生成基线(⛔ 改判据去迁就)"),
    ("—", "`bin/judge-scan` **自己不在射程**(它的正则与说明文字会自命中)⇒ "
          "扫描器自身的判据违反**本工具看不见**,由 tests 的夹具与人来看"),
    ("J9", "bin/ 侧比 HEAD 的写法:「提示 vs 闸」需语义理解 ⇒ 本扫描器只判 tests/ 下的,"
           "bin/ 若出现硬闸**看不见**"),
]


def load_baseline(path):
    if not path or not os.path.isfile(path):
        return {}
    counts = {}
    for ln in read_lines(path):
        ln = ln.strip()
        if not ln or ln.startswith("#"):
            continue
        counts[ln] = counts.get(ln, 0) + 1
    return counts


def main():
    argv = sys.argv[1:]
    repo, only, baseline, write_baseline = None, None, None, False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--repo":
            repo = argv[i + 1]; i += 2
        elif a == "--only":
            only = [x.strip().upper() for x in argv[i + 1].split(",") if x.strip()]; i += 2
        elif a == "--baseline":
            baseline = argv[i + 1]; i += 2
        elif a == "--write-baseline":
            write_baseline = True; i += 1
        else:
            i += 1
    if repo is None:
        up = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
        repo = up if os.path.isdir(os.path.join(up, "bin")) else os.getcwd()
    if not os.path.isdir(os.path.join(repo, "bin")):
        sys.stderr.write("⛔ 射程判不出:%s 下没有 bin/ ——请显式传 --repo <工具仓>。"
                         "⛔ 让本程序静默扫一个空射程:那会出一张「零阳性」的单子,"
                         "与「真的零阳性」完全同形。\n" % repo)
        return 2

    base = load_baseline(baseline)
    seen, new_hits, all_fp = {}, [], []
    for jid, jname, fn in SCANNERS:
        if only and jid not in only:
            continue
        for path in iter_files(repo):
            rel = os.path.relpath(path, repo)
            try:
                lines = read_lines(path)
            except IOError as e:
                sys.stderr.write("❓ %s 未判:%s 读不到(%s)\n" % (jid, rel, e))
                continue
            for lineno, text, why in fn(repo, path, lines):
                fp = fingerprint(jid, rel, text)
                all_fp.append(fp)
                seen[fp] = seen.get(fp, 0) + 1
                if seen[fp] <= base.get(fp, 0):
                    continue                       # 已知存量,基线放行
                new_hits.append((jid, jname, rel, lineno, text, why))

    if write_baseline:
        sys.stdout.write("# judge-scan 基线快照(已知存量;新增即红)⛔ 手工编辑\n")
        for fp in sorted(all_fp):
            sys.stdout.write(fp + "\n")
        return 0

    w = sys.stdout.write
    if new_hits:
        w("== judge-scan:**新增阳性 %d 处**(定位=防回归;已知存量由基线放行)==\n" % len(new_hits))
        for jid, jname, rel, lineno, text, why in new_hits:
            w("%s %s  %s:%d\n" % (jid, jname, rel, lineno))
            w("    %s\n" % text)
            w("    为什么:%s\n" % why)
    else:
        w("✅ judge-scan:射程内**零新增阳性**(已知存量由基线放行 ⛔ 当成零存量)\n")

    # 硬前置③:没实现/判不了的**显式列出** ⛔ 静默缺席
    w("\n-- 未判 / 本批未实现(⛔ 与「扫过没事」同形)--\n")
    for jid, jname, why in NOT_IMPLEMENTED:
        if only and jid not in only:
            continue
        w("  %s %s:%s\n" % (jid, jname, why))
    for jid, why in UNJUDGED_RUNTIME:
        if only and jid not in only:
            continue
        w("  %s 已知射程缺口:%s\n" % (jid, why))
    return 1 if new_hits else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:                       # noqa: BLE001 —— 扫描器自身异常=退出码 2
        sys.stderr.write("⛔ judge-scan 自身异常(⛔ 当成零阳性):%r\n" % (e,))
        sys.exit(2)
