#!/usr/bin/env bash
# laixin-11c-seat —— 11C 圆桌席位起停(独立 11C 脚本)
#
# ⛔ 并入 laixin-lane：首局 R4 快查②实锤 lane 的事件目录与 dispatch 锁均 HOME 级全局单例，
#    11C 工具一律独立成脚本(创始人常令「11B 不能破坏」)。本脚本零 import laixin-lane。
#
# 立项依据(全部为 2026-08-20/21 实撞，非空想)：
#   · 局二 R1 段 46m54s，近一半耗在起席阻塞与权限等待；
#   · 起席要人工过 3 个交互框(trust folder / MCP servers / 外部 CLAUDE.md import)，
#     且 **trust 记录绑 cwd**，而每局暂存目录都是新的 ⇒ 每开一局必卡一次，不是一次性摩擦；
#   · 2026-08-21 创始人直令：11C 技术自负责，⛔ 拿 yes/no 问他。
#
# 设计要点：
#   1) claude 系席位 cwd 用已信任的 $HOME，暂存区用 --add-dir 挂入。
#      ⚠️ **实测更正(2026-08-21 自测)**：这样**仍会弹 trust 框**——`--add-dir` 新挂入的目录
#      同样要过 trust，不是只认 cwd。原先「cwd 用已信任目录就零框」的预期**不成立**，
#      已由本脚本的启动序列自动应答兜住 ⇒ 对使用者仍是零交互，但机制要如实记：
#      框还在，只是不再需要人。(根因实查仍成立：~/.claude-b/.claude.json 的 projects
#      只有 /Users/pingxia 一条，trust 绑目录；对暂存区「人工按一次」永远不落盘，
#      因为每局暂存目录都是新的。)
#   2) kimi/codex 无 --add-dir 等价物 ⇒ cwd 必须是 workdir，改用各自的 trust 预写。
#   3) **MCP 默认全关、codex 分支仅放 exa**：MCP 是任意可执行程序、能读本机 OAuth 凭据，
#      01A 判为封号路径。kimi=trust 预写拒绝判据;fable=MCP 提示 Escape;codex=启动命令拼
#      enabled=false 关闭串(2026-08-21 seat-luna-research 实撞后补——此前 codex 分支裸起,
#      一窗带起 12 个 MCP 含 OAuth 型,撞「默认关、选择性开」直令)。exa 例外的依据:
#      hosted 匿名端点、零本地可执行零凭据(~/.codex/config.toml 该节有安全选型记录),
#      是创始人 2026-08-21 直令给 codex 装的检索通道,调研席(luna)靠它做外证。
#      plugin 自带 MCP 关不掉(codex 无 per-invocation 通道),见 codex_mcp_off_flags
#      注释的「已知残留」段。
#   4) 就绪判据 = **画面出现引擎特征** ⛔ 窗口存在(局二书记员自升的判据，防「空 shell 当已起席」)。
#   5) ⛔ eval ⛔ 接受任意命令串：引擎启动命令硬编码，请求方只能选枚举。

set -Eeuo pipefail

# ⚠️ 可覆盖 ⛔ 硬编码(2026-08-23):原为写死 `laixin-11c` ⇒ **隔离会话里根本测不了本脚本**——
#   而本仓的硬纪律是「自动机制类交付必须真环境首火,且首火要在隔离会话做」(四个 LAIXIN_* env 指沙盒)。
#   写死会话名 = 把自己排除在那条纪律之外:当轮补验 status 的 Working 分支时实撞(沙盒里报「窗口不存在」)。
SESSION="${LAIXIN_11C_SESSION:-laixin-11c}"
# ⚠️ 可覆盖是为了**能被测试**:三处目录若写死,绊线就只能拿真实封存档当靶子(在真目录里造
#   泄漏形态再删)——那是拿生产数据做实验,一次中断就留下脏文件。⇒ env 可覆盖,默认值不变。
ALLOW_ROOT="${LAIXIN_11C_ALLOW_ROOT:-$HOME/.laixin-11c}"
KIMI_BIN="${LAIXIN_KIMI_BIN:-$HOME/.kimi-code/bin/kimi}"
KIMI_MODEL="${LAIXIN_KIMI_MODEL:-kimi-code/k3}"
KIMI_TRUST_DIR="${LAIXIN_KIMI_TRUST_DIR:-$HOME/.kimi-code/workspace-trust}"
SEAT_SETTINGS="${LAIXIN_11C_SEAT_SETTINGS:-$ALLOW_ROOT/seat-settings.json}"
# ── 双盲的三类文件与它们必须分居的三处目录(2026-08-22 机器化;通则出自 relay 16 的两次实撞自捕)──
#   ① 代号映射全表  → SEAL_DIR   ② 各席取号文件 → PICK_DIR   ③ 席位写入的暂存区 → ALLOW_ROOT
#   **两类同居即双盲当场漏**,且漏法是「某席 ls 一下就看见了」——**不需要它做任何越界动作**:
#   实撞一(局-V02,relay 16 建档当轮自捕):取号文件写进了各席要落卷的暂存目录 ⇒ 任一席 ls 见全部三份;
#   实撞二(局七,事后发现只记形态 ⛔ 追改):取号文件放在映射表所在目录 ⇒ 拿到该目录路径的席位 ls 见映射表文件名。
#   ⇒ 判据**免语义**(纯文件位置)故可机器化;⇒ 起席前硬闸,⛔ 只写进纪律卡。
SEAL_DIR="${LAIXIN_11C_SEAL_DIR:-$HOME/.laixin-11c-seal}"
PICK_DIR="${LAIXIN_11C_PICK_DIR:-$HOME/.laixin-11c-pick}"
# ── 取号文件命名族:**唯一真相源**(生成方 / 分居自检 / 收卷比对 / 派题令模板全部读这里)────────────
# 🔴 2026-08-23 11B 归口实撞(在飞):本局三份取号文件实际叫 `pick-<32位hex>.txt` 且落在 SEAL_DIR
#   (= 代号映射全表所在目录 = 下面 (c) 项要防的「实撞二」形态),而 (c) 的判据写死 `-name '取号-*'`
#   ⇒ **认不出 pick-\*,自检全绿**。沙盒对照:同一文件同一位置,叫 pick-deadbeef.txt 报 ✅、
#   仅改名为 取号-deadbeef.txt 立刻报 ❌ —— **只差一个名字,绿与红**,正是「成功与失败同形」族。
# ⇒ 判据 ⛔ 各处各写一遍中文前缀;新增命名一律加进本数组,三处自动同步(#162)。
PICK_NAME_GLOBS=( '取号-*' 'pick-*' 'pick_*' 'PICK-*' )
# 取号文件**内容规则**:唯一真相源(2026-08-23 11C 主持裁并同轮钉进 11C 总纲 §一 R1①;派题令模板同句
# 「文件内容整串即你的代号,原样用于文件名与末行契约」)。`lastchar` 保留**只作诊断输出 ⛔ 作吻合依据**。
PICK_RULE="${LAIXIN_11C_PICK_RULE:-whole}"
pick_find_expr(){  # → stdout=可直接嵌进 find 的 \( -name A -o -name B … \) 片段(⛔ 调用方自己拼)
  local out="\\(" g first=1
  for g in "${PICK_NAME_GLOBS[@]}"; do
    [ "$first" -eq 1 ] && first=0 || out="$out -o"
    out="$out -name $g"
  done
  printf '%s \\)' "$out"
}
READY_TIMEOUT="${LAIXIN_11C_READY_TIMEOUT:-150}"
# ── claude 双账号通道(2026-08-23;创始人「11C 有 2 个 claude 账号的通道了吗…现在要换账号了」——此前 fable 席硬编码 claude-b,
#   流水线切账号时圆桌没通道可换)。解析顺序(起席时实时读 ⛔ 进程启动读一次):
#   LAIXIN_11C_CLAUDE_LAUNCHER(env)> <开关目录>/claude-launcher-11c(11C 专用;想让圆桌与流水线分账号时写它)
#   > <开关目录>/claude-launcher(与 laixin-lane **同一个**开关:创始人切账号时 11C 跟着切)> claude(与 laixin-lane 同默认)。
#   值=PATH 上的包装器名(claude→~/.claude-official,claude-b→~/.claude-b;两包装器逐字只差配置目录一行),不在 PATH 即拒起。
SWITCH_DIR="${LAIXIN_SWITCH_DIR:-$HOME/.laixin-lane-switch}"
claude_launcher_11c(){  # → stdout="<入口名> <来源说明>"
  local v src
  if [ -n "${LAIXIN_11C_CLAUDE_LAUNCHER:-}" ]; then v="$LAIXIN_11C_CLAUDE_LAUNCHER"; src="env LAIXIN_11C_CLAUDE_LAUNCHER"
  elif [ -s "$SWITCH_DIR/claude-launcher-11c" ]; then v="$(head -1 "$SWITCH_DIR/claude-launcher-11c" | tr -d '[:space:]')"; src="开关 claude-launcher-11c(11C 专用)"
  elif [ -s "$SWITCH_DIR/claude-launcher" ]; then v="$(head -1 "$SWITCH_DIR/claude-launcher" | tr -d '[:space:]')"; src="开关 claude-launcher(与流水线共用)"
  else v="claude"; src="默认"; fi
  printf '%s %s' "$v" "$src"
}
launcher_cfg_dir(){  # <入口名> → stdout=该包装器里的 CLAUDE_OFFICIAL_CONFIG_DIR(只为起席时当面说清走哪个账号;读不到显 未知 ⛔ 猜)
  local p d=""; p="$(command -v "$1" 2>/dev/null || true)"
  [ -n "$p" ] && d="$(grep -m1 -oE 'CLAUDE_OFFICIAL_CONFIG_DIR="?[^" \\]+' "$p" 2>/dev/null | cut -d= -f2- | tr -d '"' || true)"
  printf '%s' "${d:-未知}"
}

die(){ printf '❌ %s\n' "$*" >&2; exit 1; }
note(){ printf '   %s\n' "$*" >&2; }

usage(){
  cat >&2 <<'USAGE'
用法:
  laixin-11c-seat audit                                  双盲三类文件分居自检(起席前自动跑;不过即拒起)
  laixin-11c-seat start <席位名> <引擎> <议题暂存目录>   起席(自动过启动序列，就绪才返回)
  laixin-11c-seat stop  <席位名>                        收席
  laixin-11c-seat status <席位名>                       单席位状态
  laixin-11c-seat list                                  列出全部席位

引擎(枚举，⛔ 任意命令):
  fable   claude(按通道开关)+ Fable 5   cwd=$HOME(已信任) + --add-dir 暂存区
          通道=LAIXIN_11C_CLAUDE_LAUNCHER > ~/.laixin-lane-switch/claude-launcher-11c(11C 专用)
               > ~/.laixin-lane-switch/claude-launcher(与流水线共用,切账号时一起切)> claude
          ⚠️ trust 框**仍会弹,由本脚本自动应答** ⛔ 读成「零框」——
             据「零框」判断本脚本不需要 trust 应答能力,改脚本时会把应答段删掉
  k3      kimi + K3              cwd=暂存区 + kimi 信任预写(含 project MCP 拒绝判据)
  terra   codex + gpt-5.6-terra  cwd=暂存区 + laixin-11c-trust 预写
  luna    codex + gpt-5.6-luna   同上;**强制 max effort**(创始人 2026-08-21 直令「用 luna max」)
  sol     codex + gpt-5.6-sol    同上;显式 xhigh(创始人 2026-08-23 直令「书记员的模型差点意思了,后面 11C 的
          书记员用 5.6-sol」;实测横幅自报 `gpt-5.6-sol xhigh fast` ⇒ 默认已是 xhigh,仍显式带 ⛔ 依赖默认)
          ⚠️ luna 默认档只有 medium,本脚本对 luna 一律显式带 max ⛔ 依赖默认

议题暂存目录必须在 ~/.laixin-11c/ 下(白名单根，realpath 解析后校验，防 ../ 逃逸)。
USAGE
  exit 64
}

# ── 参数校验 ──────────────────────────────────────────────────────────────
valid_seat(){ [[ "$1" =~ ^seat-[a-z0-9][a-z0-9-]{0,30}$ ]]; }

pick_shape(){  # <文件…> → stdout 每行「路径(N 字节,mtime)」;⛔ 回显内容(工具输出会进日志/看板=第二条泄露路径)
  local f
  for f in "$@"; do [ -e "$f" ] || continue
    printf '     %s(%s 字节,%s)\n' "$f" "$(wc -c < "$f" | tr -d ' ')" "$(date -r "$f" '+%m-%d %H:%M' 2>/dev/null || echo '?')"
  done
}
blind_audit(){  # → 0=三类文件分居无误;1=有同居(双盲物理漏)。stdout=逐条结论
  # 🔴 **失效必须降级 ⛔ 反向**:目录不存在 ⇒ 报「不适用」而非「通过」——「没有局在跑」与
  #   「查过了没问题」在屏幕上必须长得不一样,否则这条闸会在最该管用的时候被读成绿灯。
  local bad=0 d n
  # 命名族 → find 表达式数组(⛔ 拼字符串再 eval:glob 会被当前目录内容提前展开)
  local PICK_FIND=( '(' ) _g _first=1
  for _g in "${PICK_NAME_GLOBS[@]}"; do
    [ "$_first" -eq 1 ] && _first=0 || PICK_FIND+=( '-o' )
    PICK_FIND+=( '-name' "$_g" )
  done
  PICK_FIND+=( ')' )
  printf '  -- 双盲三类文件分居(代号映射 / 取号 / 席位暂存区;命名族=%s)--\n' "${PICK_NAME_GLOBS[*]}"
  # (a) 三处目录两两不得互为前缀(同居的极端形态=一个就在另一个里面)
  local A="$SEAL_DIR/" B="$PICK_DIR/" C="$ALLOW_ROOT/"
  local x y xn yn
  for pair in "A:B" "A:C" "B:C"; do
    x="${pair%%:*}"; y="${pair##*:}"; eval "xn=\$$x"; eval "yn=\$$y"
    case "$xn" in "$yn"*) printf '  ❌ 目录互为前缀:%s 在 %s 之下 ⇒ 拿到外层路径即见内层全部\n' "$xn" "$yn"; bad=1 ;; esac
    case "$yn" in "$xn"*) printf '  ❌ 目录互为前缀:%s 在 %s 之下 ⇒ 拿到外层路径即见内层全部\n' "$yn" "$xn"; bad=1 ;; esac
  done
  # (b) 席位暂存区各局目录里 ⛔ 出现取号文件或代号映射(实撞一的形态)
  if [ -d "$ALLOW_ROOT" ]; then
    n="$( { find "$ALLOW_ROOT" -maxdepth 2 "${PICK_FIND[@]}" 2>/dev/null; find "$ALLOW_ROOT" -maxdepth 2 -name '*代号映射*' 2>/dev/null; } | head -20)"
    if [ -n "$n" ]; then printf '  ❌ 席位暂存区内出现取号/映射文件(任一席 ls 即见);形态如下(⛔ 回显内容):\n'; pick_shape $n; bad=1
    else printf '  ✅ 席位暂存区内无取号/映射文件\n'; fi
  else printf '  ℹ️ 席位暂存区不存在(%s)⇒ 本项不适用(⛔ 读成通过)\n' "$ALLOW_ROOT"; fi
  # (c) 映射表目录里 ⛔ 出现取号文件(实撞二的形态)
  if [ -d "$SEAL_DIR" ]; then
    n="$(find "$SEAL_DIR" -maxdepth 2 "${PICK_FIND[@]}" 2>/dev/null | head -20)"
    if [ -n "$n" ]; then printf '  ❌ 取号族文件出现在 PICK_DIR 之外(此处=映射表目录;拿到该目录路径的席位 ls 即见映射表文件名);形态如下(⛔ 回显内容,⛔ 只报布尔——2026-08-23 11C 主持加):\n'; pick_shape $n
      printf '     ⇒ 正确落点=%s;处置归书记员/主持(⛔ 工具自行搬动封存物)\n' "$PICK_DIR"; bad=1
    else printf '  ✅ 映射表目录内无取号文件\n'; fi
  else printf '  ℹ️ 映射表目录不存在(%s)⇒ 本项不适用(⛔ 读成通过)\n' "$SEAL_DIR"; fi
  # (d) 取号目录里 ⛔ 出现代号映射全表
  if [ -d "$PICK_DIR" ]; then
    n="$(find "$PICK_DIR" -maxdepth 2 -name '*代号映射*' 2>/dev/null | head -20)"
    if [ -n "$n" ]; then printf '  ❌ 取号目录内出现代号映射全表:\n'; printf '     %s\n' $n; bad=1
    else printf '  ✅ 取号目录内无代号映射全表\n'; fi
  else printf '  ℹ️ 取号目录不存在(%s)⇒ 本项不适用(⛔ 读成通过)\n' "$PICK_DIR"; fi
  return $bad
}

resolve_workdir(){  # <路径> → stdout=realpath；越界即 die
  # ⚠️ 先解析+校验，**通过了才 mkdir**：否则未校验的入参能让本脚本在任意位置建目录
  #    (自测实撞：传 /tmp/xxx 虽被正确拒绝，但目录已经建出来了)。
  #    realpath 用 python 解析——路径尚不存在时 `cd` 解析不了，而校验必须先于创建。
  local d="$1" rp root_rp
  root_rp="$(cd "$ALLOW_ROOT" 2>/dev/null && pwd -P)" || die "白名单根缺失：$ALLOW_ROOT"
  rp="$(python3 -c 'import os,sys;print(os.path.realpath(sys.argv[1]))' "$d" 2>/dev/null)" \
    || die "议题暂存目录无法解析：$d"
  case "$rp" in
    "$root_rp"/*) : ;;
    *) die "议题暂存目录越界：$rp ⛔ 不在 $root_rp 下(白名单根)" ;;
  esac
  mkdir -p "$rp" 2>/dev/null || die "议题暂存目录不可创建：$rp"
  printf '%s\n' "$rp"
}

# ── kimi 信任预写(照 laixin-lane 逻辑独立实现，⛔ import) ──────────────────
kimi_wd_key(){
  local p="$1" base slug hash
  p="${p%"${p##*[!/]}"}"
  base="${p##*/}"
  slug="$(LC_ALL=C printf '%s' "$base" | LC_ALL=C tr 'A-Z' 'a-z' \
          | LC_ALL=C sed -E 's/[^a-z0-9._-]+/-/g; s/^-+//; s/-+$//' \
          | LC_ALL=C cut -c1-40 | LC_ALL=C sed -E 's/^-+//; s/-+$//')"
  case "$slug" in ""|"."|"..") slug="workspace" ;; esac
  hash="$(printf '%s' "$p" | shasum -a 256 | cut -c1-12)"
  printf 'wd_%s_%s\n' "$slug" "$hash"
}

kimi_project_mcp(){  # 逐行打印存在的 project 级 MCP 配置；零输出=没有
  local d="$1" root=""
  [ -f "$d/.kimi-code/mcp.json" ] && echo "$d/.kimi-code/mcp.json"
  root="$d"
  while :; do
    if [ -e "$root/.git" ]; then break; fi
    case "$root" in ""|"/") root=""; break ;; esac
    root="$(dirname "$root")"
  done
  [ -n "$root" ] && [ -f "$root/.mcp.json" ] && echo "$root/.mcp.json"
  return 0
}

kimi_trust_prewrite(){
  # ⚠️ ⛔ 无条件预写：kimi 的 trust 语义逐字是「启用 project MCP servers」，
  #    project 级 stdio 条目会话启动即起进程 ⇒ 无条件预写=替人按掉一个安全决定(#68 判据)。
  #    该判据每次起席都跑 ⛔ 一次性——目录将来可能新增 MCP 配置，而已有信任记录会让它无声生效。
  local d="$1" key f mcp
  mcp="$(kimi_project_mcp "$d" || true)"
  if [ -n "$mcp" ]; then
    die "⛔ 拒绝自动信任 $d：发现 project 级 MCP 配置
$(echo "$mcp" | sed 's/^/     /')
   kimi 的 trust 语义逐字是「启用 project MCP servers」，stdio 条目会话启动即起进程。
   要起该席：先人工确认这些 MCP 条目可信，再手动在 kimi 里选 Trust(或删掉该配置)。"
  fi
  key="$(kimi_wd_key "$d")"
  f="$KIMI_TRUST_DIR/$key"
  [ -f "$f" ] && { note "kimi 信任记录已存在($key)，幂等跳过"; return 0; }
  mkdir -p "$KIMI_TRUST_DIR" && chmod 700 "$KIMI_TRUST_DIR" 2>/dev/null || true
  printf '{"root":"%s","trustedAt":%s}' "$d" "$(python3 -c 'import time;print(int(time.time()*1000))')" > "$f"
  chmod 600 "$f" 2>/dev/null || true
  note "已预写 kimi 信任记录 $key"
}

# ── codex MCP 默认关(照 laixin-lane 手法独立实现，⛔ import) ────────────────
# 立项:2026-08-21 seat-luna-research 实撞——codex 分支裸起 `codex`,一窗带起 12 个 MCP
#   (含 linear 等 OAuth 型与 node_repl 等本地可执行),撞创始人准则 2(MCP=凭据外流实源)
#   与 2026-08-18「默认关、选择性开」直令。kimi/fable 分支各有兜底,唯 codex 分支裸奔。
# 手法:`-c mcp_servers.<名>.enabled=false`,key 一律裸拼零引号——codex -c 的 dotted path
#   是纯字符串切分,引号包 key 会被当字面名建新表 ⇒ 整份 config 拒载、codex 秒退
#   (laixin-lane 2026-08-18 实撞;`codex mcp list -c 'mcp_servers."node_repl".enabled=false'`
#   可复现拒载)。
# ⛔ 硬编码名单:lane 的十名单就漏了后来新增的 codegraph——静态名单会烂。改为起席时从
#   ~/.codex/config.toml 现场取全量 [mcp_servers.*] 名,除白名单(仅 exa)外全关;
#   名字含裸拼不了的字符时 die ⛔ 静默漏关(bare dotted path 关不掉它=席位会带着它起来)。
# ⚠️ 已知残留(2026-08-21 实测,本脚本修不掉,如实记 ⛔ 读成「席位零 MCP」):
#   plugin 自带的 MCP 不吃本关闭串——实测起席后仍有 playwright@claude-plugins-official
#   (npx playwright-mcp)与 data-analytics@openai-curated-remote(server.cjs)两个进程,
#   且 `codex mcp list` 连后者都不显示(list 不是 plugin 层的 ground truth)。
#   已试尽 per-invocation 通道:对其名拼 mcp_servers.<名>.enabled=false ⇒ 整份 config
#   拒载(实测复现);-c plugins.<键>.enabled=false 裸拼/引号两式在 mcp list 与真实会话
#   均无效(进程照起)。唯一关法=改 plugin 缓存 .mcp.json 或 config [plugins] 节,
#   属持久全局改动、影响创始人自用 codex ⇒ 超出席位脚本射程,残留面已上报方案窗口。
#   真实态=config 级全关 + exa 放行 + plugin 层残留(全机 codex 会话共有,非席位特有)。
codex_mcp_off_flags(){
  local cfg="${CODEX_HOME:-$HOME/.codex}/config.toml" allow=" exa " s out="" seen=" " closed=""
  [ -f "$cfg" ] || return 0   # 无 config 即无 MCP,零关闭串是真实状态
  while IFS= read -r s; do
    case "$seen" in *" $s "*) continue ;; esac   # 去重([mcp_servers.x.env] 等子表同名)
    seen="$seen$s "
    case "$allow" in *" $s "*) continue ;; esac
    [[ "$s" =~ ^[A-Za-z0-9_-]+$ ]] \
      || die "MCP 名含裸拼不了的字符:$s——关闭串关不掉它,⛔ 静默漏关(人工处理后再起席)"
    out="$out -c mcp_servers.$s.enabled=false"
    closed="$closed $s"
  done < <(sed -n 's/^\[mcp_servers\.\([^].]*\).*/\1/p' "$cfg")
  [ -n "$closed" ] && note "codex MCP 默认全关(仅放 exa):${closed# }"
  printf '%s' "$out"
}

# ── 启动序列自动应答 ──────────────────────────────────────────────────────
# 每个分支都对应一次实撞或 laixin-lane 既有处理，⛔ 见框就回车
answer_prompts(){  # <window> <pane文本>
  local w="$1" pane="$2"
  case "$pane" in
    *"MCP servers"*)
      # 安全默认:全部拒绝。席位不需要 MCP;MCP=任意可执行程序,能读 OAuth 凭据(01A 封号路径)
      tmux send-keys -t "$SESSION:$w" Escape; note "MCP 提示 → 全部拒绝(Escape)"; return 0 ;;
    *"trust this folder"*|*"Do you trust the files"*)
      tmux send-keys -t "$SESSION:$w" C-m; note "trust 提示 → 确认(暂存区为本机自建目录)"; return 0 ;;
    *"external"*"imports"*|*"CLAUDE.md file imports"*)
      tmux send-keys -t "$SESSION:$w" C-m; note "外部 import 提示 → 确认(本机自有文件)"; return 0 ;;
    *"Update available"*)
      tmux send-keys -t "$SESSION:$w" Escape; note "更新提示 → 跳过"; return 0 ;;
  esac
  return 1
}

seat_ready(){  # <引擎> <pane文本> → 0=就绪。判据=画面出现引擎特征 ⛔ 窗口存在
  local engine="$1" pane="$2"
  case "$engine" in
    fable) [[ "$pane" == *"auto mode on"* || "$pane" == *"Fable 5"* ]] ;;
    k3)    [[ "$pane" == *"Kimi Code"* || "$pane" == *"No session yet"* || "$pane" == *"K3"* ]] ;;
    terra|luna|sol) [[ "$pane" == *"Codex"* || "$pane" == *"codex"* ]] ;;
    *) return 1 ;;
  esac
}

# ── 起席 ──────────────────────────────────────────────────────────────────
cmd_start(){
  local seat="${1:-}" engine="${2:-}" wd_in="${3:-}"
  [ -n "$seat" ] && [ -n "$engine" ] && [ -n "$wd_in" ] || usage
  valid_seat "$seat" || die "席位名不合法：$seat(须匹配 ^seat-[a-z0-9][a-z0-9-]{0,30}\$)"
  case "$engine" in fable|k3|terra|luna|sol) : ;; *) die "未知引擎：$engine(只接受 fable|k3|terra|luna|sol)" ;; esac
  # claude 通道在一切副作用之前解析+校验(⛔ 起到一半才发现入口不存在)
  local _cl="" _clsrc=""
  if [ "$engine" = "fable" ]; then
    read -r _cl _clsrc <<< "$(claude_launcher_11c)"
    # ⚠️ 变量后紧跟全角字符一律 ${var}(bash 3.2 中文 locale 把「」()卷进变量名 ⇒ set -u 炸;本仓 AGENTS 第四发,本行首版实撞)
    command -v "${_cl}" >/dev/null 2>&1 || die "claude 入口「${_cl}」不在 PATH(来源=${_clsrc})——通道值只认 PATH 上的包装器(claude / claude-b);核:ls ~/.local/bin/claude*;改开关:echo claude > ~/.laixin-lane-switch/claude-launcher-11c(11C 专用)或 …/claude-launcher(与流水线共用)"
    note "claude 通道=${_cl}(来源=${_clsrc};配置目录=$(launcher_cfg_dir "${_cl}"))"
  fi

  local wd; wd="$(resolve_workdir "$wd_in")"

  # 🔴 双盲硬闸:**起席之前**核三类文件分居 —— 双盲一旦漏就是整局作废,而漏的代价远高于
  #   「起席被拦一次」。⛔ 起完席再查(那时席位已经能 ls 了);⛔ 只警告不拦(fail-closed)。
  if [ "${LAIXIN_11C_SKIP_BLIND_AUDIT:-}" = "1" ]; then
    note "⚠️ 双盲分居检查被 LAIXIN_11C_SKIP_BLIND_AUDIT=1 显式跳过(未核,风险自担)"
  elif ! blind_audit; then
    die "双盲三类文件分居检查未过(见上)——**⛔ 起席**:某席 ls 一下即可看见不该看见的东西,双盲当场漏。
   修法=三类文件三处放:代号映射→$SEAL_DIR · 取号→$PICK_DIR · 席位暂存区→$ALLOW_ROOT;把越位的文件挪回各自的处,再重跑。
   (仅在确认本局不走双盲时可用 LAIXIN_11C_SKIP_BLIND_AUDIT=1 显式跳过,⛔ 当常规手段)"
  fi

  tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION" -n hub
  if tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$seat"; then
    die "席位窗口已存在：$seat(先 stop，⛔ 覆盖起窗)"
  fi

  # 引擎特定的 trust 前置 + 启动命令(硬编码，⛔ 拼接外部输入为命令)
  local launch cwd _mcp_off
  case "$engine" in
    fable)
      # cwd 用已信任的 $HOME，暂存区用 --add-dir 挂入(trust 框仍会出现，由启动序列应答)
      # --settings：仅含 remoteControlAtStartup=false，**结构性关掉 Remote Control**——
      #   席内 /rc active 意味着会话可从 claude.ai 侧访问，对双盲是多余的暴露面；
      #   起席后再关需向席内发输入、污染派题前的干净基线(方案窗口 2026-08-21 提，实据=自测
      #   画面右下 `/rc connecting…`)。该文件不含 permissions ⇒ ⛔ 触发专线自检。
      [ -f "$SEAT_SETTINGS" ] || {
        printf '{\n  "remoteControlAtStartup": false\n}\n' > "$SEAT_SETTINGS"
        note "已生成席位 settings：$SEAT_SETTINGS(仅关 RC，⛔ 含 permissions)"
      }
      cwd="$HOME"
      launch="${_cl} -n $seat --model claude-fable-5 --permission-mode auto"   # 入口=通道开关解析结果(2026-08-23 起 ⛔ 硬编码 claude-b)
      launch="$launch --settings $SEAT_SETTINGS --add-dir $wd"
      ;;
    k3)
      kimi_trust_prewrite "$wd"
      cwd="$wd"
      launch="\"$KIMI_BIN\" --auto -m $KIMI_MODEL"
      ;;
    terra)
      if command -v laixin-11c-trust >/dev/null 2>&1; then
        laixin-11c-trust "$wd" >/dev/null || die "codex trust 预写失败：$wd"
        note "已对 $wd 跑 laixin-11c-trust"
      else
        note "⚠️ laixin-11c-trust 不在 PATH，codex 可能弹 trust 框(将由启动序列应答兜底)"
      fi
      cwd="$wd"
      _mcp_off="$(codex_mcp_off_flags)"
      launch="codex$_mcp_off"
      ;;
    luna)
      # 调研席/批量席配型(创始人 2026-08-21 直令「用 luna max」「错配的那个 sol 改成 luna max」)
      # ⚠️ luna 的 default_reasoning_level = medium,**必须显式带 max** ⛔ 依赖默认档
      #    (max 逐字="Maximum reasoning depth for the hardest problems",高于 terra 现用 xhigh)
      # ⚠️ 通道注记:codex 系无原生网页搜索(search_tool removed / web_search_* deprecated /
      #    standalone_web_search 未上线,仅 browser_use stable)⇒ 本席做消化判断,
      #    **检索那半按配型表走 claude 通道或 browser_use** ⛔ 指望它端到端出调研包。
      if command -v laixin-11c-trust >/dev/null 2>&1; then
        laixin-11c-trust "$wd" >/dev/null || die "codex trust 预写失败：$wd"
        note "已对 $wd 跑 laixin-11c-trust"
      else
        note "⚠️ laixin-11c-trust 不在 PATH，codex 可能弹 trust 框(将由启动序列应答兜底)"
      fi
      cwd="$wd"
      _mcp_off="$(codex_mcp_off_flags)"
      launch="codex -m gpt-5.6-luna -c model_reasoning_effort='\"max\"'$_mcp_off"
      ;;
    sol)
      # 书记员/记录席配型(创始人 2026-08-23 直令「书记员的模型差点意思了,后面 11C 的书记员用 5.6-sol」)
      # ⚠️ 实测(隔离会话真起)横幅自报 `gpt-5.6-sol xhigh fast` ⇒ 默认档已是 xhigh;仍**显式带**
      #    ⛔ 依赖默认(luna 那次正是默认 medium 咬人)。
      launch="codex -m gpt-5.6-sol -c model_reasoning_effort='\"xhigh\"'$_mcp_off"
      ;;
  esac

  tmux new-window -d -t "$SESSION" -n "$seat" -c "$cwd"
  tmux send-keys -t "$SESSION:$seat" "$launch" C-m
  note "已起窗 $SESSION:$seat(引擎=$engine cwd=$cwd)"

  # 轮询：过启动序列 + 等就绪
  local waited=0 pane
  while [ "$waited" -lt "$READY_TIMEOUT" ]; do
    sleep 3; waited=$((waited+3))
    tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$seat" \
      || die "席位窗口在启动中消失：$seat(引擎异常退出，⛔ 当作已起席)"
    pane="$(tmux capture-pane -t "$SESSION:$seat" -p -S -40 2>/dev/null || true)"
    if seat_ready "$engine" "$pane"; then
      printf '✅ 席位就绪：%s(引擎=%s，耗时约 %ss，⛔ 已向席内发送任何输入)\n' "$seat" "$engine" "$waited"
      return 0
    fi
    answer_prompts "$seat" "$pane" || true
  done
  die "席位 ${READY_TIMEOUT}s 未就绪：$seat —— 窗口保留供人工深读(⛔ 自动收席，现场即证据)"
}

cmd_stop(){
  local seat="${1:-}"; [ -n "$seat" ] || usage
  valid_seat "$seat" || die "席位名不合法：$seat"
  tmux kill-window -t "$SESSION:$seat" 2>/dev/null && printf '已收席：%s\n' "$seat" || die "席位不存在：$seat"
}

cmd_status(){  # <席位名> [--pane N]
  # 🔴 #169(2026-08-23 dispatch-11c 首任报,当轮修):**默认零画面**。
  #   原实现固定打印「画面末 8 行」⇒ 判个死活就把**席位作答正文**带上屏(实撞:17:43:10 判三席死活时
  #   带出某席 R2 作答正文片段)。而 11C 总纲**收卷禁深读条**规定 dispatch 在收卷/开牌阶段的判据
  #   **只许**「status 的 Working 与否 + 暂存区文件数」——⇒ **条文点名的那个判据,其工具实现本身就越限**,
  #   不是调用方多加了参数。⭐ 这一族的通则:**默认行为要安全,越限要显式**(构造保证 > 事后断言 > 记性)。
  # 活性判据=**无内容活性探针**(dispatch-11c 提供,当轮采纳):同窗两次 capture 只比对 SHA 是否变化,
  #   输出仅「Working/静止」,**零正文出屏** ⛔ 靠词表匹配画面(那要把画面读进来)。
  local seat="" pane_n=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --pane) pane_n="${2:?--pane 需要行数}"; shift 2 ;;
      *) seat="$1"; shift ;;
    esac
  done
  [ -n "$seat" ] || usage
  tmux list-windows -t "$SESSION" -F '#{window_name}' 2>/dev/null | grep -qx "$seat" || { printf '%s：窗口不存在\n' "$seat"; return 1; }
  local h1 h2 act
  h1="$(tmux capture-pane -t "$SESSION:$seat" -p 2>/dev/null | shasum -a 256 2>/dev/null | cut -c1-16)"
  sleep 1.2
  h2="$(tmux capture-pane -t "$SESSION:$seat" -p 2>/dev/null | shasum -a 256 2>/dev/null | cut -c1-16)"
  # 🔴 **本探针只有两态,而「静止」对应三个真值**(2026-08-23 dispatch-11c 首任自我认领,当轮写进输出本体):
  #   它 R2 收卷前用本命令判三席「已停笔」,当时确实是完成态——**但那是运气不是判据**;真正把「完成」
  #   从「思考/卡死」里分出来的是**另一条**判据(带末行契约的文件数 3/3)。
  # ⭐ 通则:**探针的态数少于问题的态数时,它会在两个不同的真值上给出同一个读数,而调用方从读数上看不出这件事。**
  #   ⇒ 所以警告不能只写「⛔ 读成已完卷」,要**点明它分不出哪三态、并指向真判据**。
  if [ -n "$h1" ] && [ "$h1" != "$h2" ]; then
    act="Working(画面在变)"
  else
    act="静止 —— ⚠️ 本探针**只分「变/不变」两态,而静止对应三个真值:①答完在等 ②还在思考 ③已卡死**,它分不出是哪个。
        判「完成」的**真判据**=该席暂存区里带末行契约的文件数(⛔ 用本行);本行只回答「窗口还在、别对着死窗发 stop」。"
  fi
  printf '%s：窗口在 · %s\n' "$seat" "$act"
  if [ "$pane_n" -gt 0 ] 2>/dev/null; then
    # 显式要画面才给,且**硬上限 3 行**(总纲禁深读条:必须看现场时 ≤3 行且 ⛔ 含正文区)
    [ "$pane_n" -le 3 ] || { printf '  ⛔ --pane 上限 3 行(11C 总纲收卷禁深读条);你要的 %s 行被拒 ⇒ 按 3 行给\n' "$pane_n"; pane_n=3; }
    printf -- '--- 画面末 %s 行(⚠️ 可能含作答正文:看到即止 ⛔ 记录 ⛔ 转述 ⛔ 写入任何公开面)---\n' "$pane_n"
    tmux capture-pane -t "$SESSION:$seat" -p -S -"$pane_n" 2>/dev/null
  fi
}

cmd_list(){
  tmux has-session -t "$SESSION" 2>/dev/null || { echo "session $SESSION 不存在"; return 0; }
  printf '%s 的窗口：\n' "$SESSION"
  tmux list-windows -t "$SESSION" -F '  #{window_index}: #{window_name}'
}


cmd_pickcheck(){  # <取号文件> <回卷标识> → 报**两侧形态差**与逐规则判定;⛔ 回显任何一侧内容
  # #162(2026-08-23 11C 主持给单,理由=**手工校验脆弱**——本局 R1 收卷卡住的真根因是书记员手工 zsh
  #   扫描命令中文正则未正确引用致比对全 no,而取号/提取/回卷三者本来一致)。规格逐字:
  #   「取号生成+回卷比对**同一规则**;比对失败时**报两侧形态差**(文件 N 字符 / 回卷 M 字符 / 取末字是否吻合)**⛔ 只报 yes/no**」。
  # 🔴 **⛔ 回显内容**:本命令的输出会进终端/日志/看板,回显任一侧内容=开第二条泄露路径 ⇒ 只出**字符数、字节数、吻合与否**。
  # 🔴 **规则归主持定 ⛔ 工具钉死**:whole(整串即代号)与 lastchar(末字即代号)两种解释**含义相反**,
  #   本命令**两种都算并都报**,由主持按 11C 总纲定；工具只保证生成/检查/比对**读同一处**(PICK_NAME_GLOBS 与本函数)。
  local pf="${1:-}" ret="${2:-}"
  [ -n "$pf" ] && [ -n "$ret" ] || { printf '⛔ 用法:laixin-11c-seat pickcheck <取号文件> <回卷标识(文件名或末行契约里的那个串)>\n'; return 2; }
  [ -f "$pf" ] || { printf '⛔ 取号文件不存在:%s(⛔ 读成「不吻合」——读不到与不吻合必须分辨)\n' "$pf"; return 2; }
  PICK_F="$pf" RET_S="$ret" PICK_RULE="$PICK_RULE" python3 - <<'PY2'
import os,sys,io
raw=io.open(os.environ["PICK_F"],encoding="utf-8",errors="replace").read()
pick=raw.strip(); ret=os.environ["RET_S"].strip()
pc,pb=len(pick),len(pick.encode("utf-8")); rc,rb=len(ret),len(ret.encode("utf-8"))
whole = (pick==ret)
last  = bool(pick) and bool(ret) and (pick[-1]==ret[-1]) and rc==1
lastin= bool(pick) and bool(ret) and (pick[-1] in ret)
print("  取号文件形态:%d 字符 / %d 字节(⛔ 回显内容)" % (pc,pb))
print("  回卷标识形态:%d 字符 / %d 字节(⛔ 回显内容)" % (rc,rb))
rule=os.environ.get("PICK_RULE","whole")
print("  生效规则:%s(单点源 PICK_RULE;11C 总纲 §一 R1① 钉死=whole 整串即代号)" % rule)
ok = whole if rule=="whole" else last
print("    %-8s ← **吻合依据**            : %s" % (rule, "✅ 吻合" if ok else "❌ 不吻合"))
print("  诊断输出(⛔ 作吻合依据,只用于查错):")
print("    whole    整串即代号                : %s" % ("吻合" if whole else "不吻合"))
print("    lastchar 末字即代号(回卷恰 1 字符) : %s" % ("吻合" if last else "不吻合"))
print("    末字包含于回卷                     : %s" % ("是" if lastin else "否"))
if ok:
    print("  ⇒ 按生效规则吻合。")
    sys.exit(0)
if last or lastin:
    print("  ⚠️ 生效规则不吻合,但诊断显示末字相关吻合 —— **⛔ 据此收卷**:规则已钉死为 %s;" % rule)
    print("     这种形态通常意味着**生成方或席位仍按旧口径**,处置归书记员/主持(⛔ 工具放行)。")
print("  ⇒ 不吻合。形态差就在上面两行(%d 字符 vs %d 字符)——" % (pc,rc))
print("     若字符数本就不同,先查**生成规则与提取口径是否同一处**;若字符数相同仍不吻合,再查比对命令本身")
print("     (本单的真根因即**手工比对命令的正则未正确引用**,而当时只报了 label_match=no ⇒ 人只能去猜)。")
sys.exit(1)
PY2
}

case "${1:-}" in
  start)  shift; cmd_start "$@" ;;
  stop)   shift; cmd_stop "$@" ;;
  status) shift; cmd_status "$@" ;;
  list)   shift; cmd_list "$@" ;;
  audit)  shift; blind_audit ;;   # 双盲三类文件分居自检(起席前自动跑,也可单独跑)
  pickcheck) shift; cmd_pickcheck "$@" ;;   # 取号 × 回卷比对:报两侧形态差 ⛔ 只报布尔 ⛔ 回显内容(#162)
  *) usage ;;
esac
