# ---- 派工权认领:用"谁在动 lane"识别派工窗口,而不是数窗口个数 ----
# 数量是身份的不可靠代理(开窗口问问题 vs 开窗口接管派工,在"数量"里长得一样);
# 而 send 是派工窗口的定义性行为 ⇒ 直接测行为,不猜身份。
# ⚠️ 可覆盖(2026-08-22 实撞):tests/run.sh 的 halt fixture 用假会话/假看板/假托管标记却用**真 HOME 的锁**
#   ⇒ cmd_halt 末尾「持有者==dispatch 就 rm 锁」把**在班 dispatch 的派工权删了**,而套件自述「绝不碰派工权锁」、
#   跑完全绿。锁路径必须与 LAIXIN_BOARD/LAIXIN_SESSION 同等可被 fixture 接管,否则「零副作用」只是自述。
DISPATCH_LOCK="${LAIXIN_DISPATCH_LOCK:-$HOME/.laixin-dispatch.lock}"
LOCK_FRESH="${LAIXIN_LOCK_FRESH:-1800}"   # 心跳新鲜期(秒),默认 30 分钟

whoami_window() {   # 调用者所在的 tmux 窗口名;不在 tmux 里则记为 external:<pid>
  if [ -n "${TMUX_PANE:-}" ]; then
    tmux display-message -p -t "$TMUX_PANE" '#{window_name}' 2>/dev/null || echo "external:$PPID"
  else
    echo "external:$PPID"
  fi
}

lock_renew() {  # <持有者名> 原子续期(先写临时文件再 mv,避免读到半写状态);保名续期供看门狗代续
  local t; t="$(mktemp "${DISPATCH_LOCK}.XXXX")"
  printf '%s %s\n' "$1" "$(date +%s)" > "$t" && mv -f "$t" "$DISPATCH_LOCK"
}
lock_write() { lock_renew "$(whoami_window)"; }
lock_renew_if_holder() {  # 复盘页#19-(a):在班行为续期,但只当调用者==当前持有者(中继/验收也跑 log/peek,
  # 不带身份校验会给死锁续命——登记时中继实测的反例);挂在 duty 命令路由前,零副作用零输出
  [ -f "$DISPATCH_LOCK" ] || return 0
  [ "$(lock_holder)" = "$(whoami_window)" ] && lock_renew "$(lock_holder)" || true
}
lock_holder(){ [ -f "$DISPATCH_LOCK" ] && awk '{print $1}' "$DISPATCH_LOCK" || echo ""; }
lock_age()   { [ -f "$DISPATCH_LOCK" ] || { echo 999999; return; }; echo $(( $(date +%s) - $(awk '{print $2}' "$DISPATCH_LOCK") )); }

# 是否有"别人"正持有派工权(持有者不是 dispatch 窗口,且心跳新鲜)
rival_holds_dispatch() {
  local h; h="$(lock_holder)"
  [ -n "$h" ] || return 1
  [ "$h" = "$DISPATCH_WIN" ] && return 1
  [ "$(lock_age)" -lt "$LOCK_FRESH" ]
}

cmd_claim() {
  local h; h="$(lock_holder)"
  if [ -n "$h" ] && [ "$h" != "$(whoami_window)" ] && [ "$(lock_age)" -lt "$LOCK_FRESH" ]; then
    echo "⚠️ 派工权当前由 [$h] 持有(心跳 $(lock_age) 秒前)。"
    echo "   绝不允许两个派工窗口同时活着——先确认它已收工,再 laixin-lane claim --force"
    [ "${1:-}" = "--force" ] || return 1
    echo "   (--force:强行接管)"
  fi
  lock_write
  board "$(caller_src)" "认领派工权:$(whoami_window)"   # #57:claim 是「想成为派工」的动作,来源写角色名=用结论当证据;真实身份已在消息里
  echo "已认领派工权:$(whoami_window)"
  return 0
}

cmd_whoholds() {
  local h; h="$(lock_holder)"
  if [ -z "$h" ]; then echo "派工权:无人认领(锁文件不存在)"; return 0; fi
  local a; a="$(lock_age)"
  if [ "$a" -lt "$LOCK_FRESH" ]; then echo "派工权:[$h] 持有中(心跳 ${a}s 前,新鲜期 ${LOCK_FRESH}s)"
  elif [ "$h" = "$DISPATCH_WIN" ] && dispatch_alive; then
    echo "派工权:[$h] 心跳过期(${a}s 前)但持有者窗口仍在班(#19-b 两态区分)⇒ **非可接管**——有意节流形态;看门狗下一拍会代续,或持有者跑任一 duty 命令即续"
  else echo "派工权:[$h] 已失效(心跳 ${a}s 前,超过新鲜期 ${LOCK_FRESH}s,且持有者窗口不在班)⇒ 视为无人持有"; fi
  return 0
}

# 活跃 claude 会话(socket 名即 PID,能与进程对上);排除 tmux 内已知窗口的会话 ⇒ 剩下的是"手开的窗口"
# #60①:验收引擎默认 codex 后,verify-* 窗口 pane 同样是 node 但**不产 cc-sock**——原「按窗口数减」
# 会把无 sock 的 codex 验收窗口也减掉:计数可为负,且恰在「真有第二个手开 claude」时把它减没
# (检查失效恰好指向它要防的双派工风险,三约束② 反向)。⇒ 改按 **tty 精确配对**:sock 进程的
# 控制终端 ∈ 已知窗口 pane tty 才算「tmux 内」——引擎无关、窗口数无关(2026-08-19 真机逐对核过:
# dispatch/relay/verify 三窗 pane_tty 与其 claude 进程 ps -o tty= 一一吻合)。配对取不到 tty 时
# 该会话算「外部」(多算朝告警侧,⛔ 少算朝掩蔽侧)。
CC_SOCKS_DIR="${LAIXIN_CC_SOCKS:-/tmp/cc-socks}"   # 可覆盖:绊线测试用 fixture 目录
outside_sessions() {
  local ttys sk pid ptty total=0 inside=0
  ttys="$(tmux list-panes -s -t "$SESSION" -F '#{window_name} #{pane_tty}' 2>/dev/null \
    | awk '$1 ~ /^(dispatch|relay|verify-)/ {print $2}')"
  for sk in "$CC_SOCKS_DIR"/*.sock; do
    [ -S "$sk" ] || continue
    pid="$(basename "$sk" .sock)"
    ps -p "$pid" >/dev/null 2>&1 || continue
    total=$((total+1))
    ptty="$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')"
    if [ -n "$ptty" ] && [ "$ptty" != "??" ] && grep -q "/dev/${ptty}\$" <<< "$ttys"; then inside=$((inside+1)); fi
  done
  echo $(( total - inside ))
}

# ── 通道一致性(账号隔离,2026-08-19 立;创始人「claude 和 claude-b 分开通道」)────────────
# 实证:窗口互见(ListAgents)与 SendMessage 寻址按 **CLAUDE_OFFICIAL_CONFIG_DIR 分区** ——
# 方案窗口 19:3x 在 .claude-b 时看不到尚在 .claude-official 的 dispatch/relay;三件套 19:58
# 迁入同目录后三方对称互见(dispatch/relay/11B 各见另外两个,且各不含自己)。
# ⚠️ **多通道并存不是错误** —— 创始人定的运行形态:两条通道各自独立跑,一条的 token 将尽时
#   逐步停工、另一条逐步拉起,在流水线上**软切换**(今天是 claude 将尽,下次可能是 claude-b)。
#   ⇒ 本检查 ⛔ 把"有两个目录"判成错,那会把正常的切换中间态报成故障。
# 🔴 真正该报的是两种,都无声:①**两个通道同时有 dispatch** —— 违反「绝不允许两个派工窗口
#   同时活着」,而两条线各自看都正常;②**孤儿席位** —— 某通道里只剩一个 dispatch/relay,
#   跨通道消息发不到,它没有任何可通信对象,却照样在跑。2026-08-19 19:34~19:58 真实出现过
#   ②的雏形(方案窗口已切、三件套未切),零告警,是事后复盘拓扑才发现的。
# ⛔ 用 pgrep 找会话进程:**调用者看不见自己所在会话的 claude 进程**(当日三方对称实证:
#   dispatch/relay/11B 各自跑 `pgrep -f claude` 都缺自己那个 pid,relay 因此把污染误判为
#   "没复现")⇒ 走 sock 名即 PID;`ps` 按 pid 读是可靠的(relay 实测读到自己 781 字符命令行)。
session_seats() {  # → stdout 每行 "<pid> <配置目录> <席位名|outside>";读不到配置目录的会话跳过
  local ttys sk pid ptty dir seat
  # 席位识别与 outside_sessions 同口径:控制终端 ∈ 已知窗口 pane tty 才算 tmux 内席位
  ttys="$(tmux list-panes -s -t "$SESSION" -F '#{pane_tty} #{window_name}' 2>/dev/null \
    | awk '$2 ~ /^(dispatch|relay|verify-)/ {print}')"
  for sk in "$CC_SOCKS_DIR"/*.sock; do
    [ -S "$sk" ] || continue
    pid="$(basename "$sk" .sock)"
    ps -p "$pid" >/dev/null 2>&1 || continue
    dir="$(ps eww -o command= -p "$pid" 2>/dev/null | tr ' ' '\n' \
           | grep -m1 '^CLAUDE_OFFICIAL_CONFIG_DIR=' | cut -d= -f2-)"
    [ -n "$dir" ] || continue
    ptty="$(ps -o tty= -p "$pid" 2>/dev/null | tr -d ' ')"; seat=""
    [ -n "$ptty" ] && [ "$ptty" != "??" ] && seat="$(awk -v t="/dev/$ptty" '$1==t {print $2; exit}' <<< "$ttys")"
    printf '%s %s %s\n' "$pid" "$dir" "${seat:-outside}"
  done
}

# 判定与取数**分离**:本函数只读 stdin、⛔ 引用任何顶层变量 —— #75 的教训逐字适用
# (顶层变量不被绊线的函数抽取带走,引用它会在测试里静默撞 set -u)⇒ 两个分支都可直接喂数据测。
channel_verdict() {  # stdin=每行 "<pid> <目录> <席位>" → stdout 多行报告;rc 0=健康 1=危险 2=无数据
  awk '
    { n++; cnt[$2]++; if ($3!="outside") seats[$2]=seats[$2]" "$3; else ext[$2]++
      if ($3=="dispatch") disp[$2]=1; if ($3=="relay") rly[$2]=1 }
    END {
      if (n==0) { print "  ℹ️ 通道拓扑:未读到任何会话的配置目录 ⇒ 不适用"; exit 2 }
      nd=0; ndisp=0
      for (d in cnt) { nd++; if (d in disp) ndisp++ }
      for (d in cnt) {
        line = (d in seats ? seats[d] : "")
        if (ext[d]) line = line " +" ext[d] "个tmux外窗口"
        printf "  通道 %s:%s (共 %d 会话)\n", d, (line==""?" —":line), cnt[d]
      }
      bad = 0
      # 危险①:派工唯一性是跨通道的硬纪律(锁在文件层,但拓扑层要先看得见)
      if (ndisp > 1) {
        print "  🔴 " ndisp " 个通道同时有 dispatch —— 违反「绝不允许两个派工窗口同时活着」;软切换必须旧线先交出派工权"
        bad = 1
      }
      # 危险②:孤儿席位——跨通道 SendMessage 发不到,同通道内没有别的会话即无任何可通信对象
      for (d in cnt) if ((d in disp || d in rly) && cnt[d] == 1) {
        print "  🔴 通道 " d " 内只有这一个会话,而它是派工/中继席位 —— 跨通道消息发不到,它没有任何可通信对象(孤儿)"
        bad = 1
      }
      if (bad == 0) {
        if (nd == 1) print "  ✅ 单通道运行,拓扑完整"
        else print "  ✅ 软切换态:" nd " 个通道并存(属正常),派工窗口唯一,各通道内均有可通信对象"
      }
      exit bad
    }'
}

# ── 通道额度到线提醒(2026-08-22 创始人裁「先问机器化」立):CC 双账号按额度轮换,
#   而「该切了」此前**只存在于人去开仪表盘看一眼**——没有任何机器面,漏看的代价是
#   账号跑干后流水线停摆。判据源=cc-usage-monitor(127.0.0.1:8763,01A 项目包)拉的
#   官方额度;通道↔账号映射取 `<配置目录>/.claude.json` 的 oauthAccount.emailAddress
#   (2026-08-22 实测两通道均有此字段),⛔ 靠 Keychain 后缀反推(要授权,无人值守下会挂)。
# 🔴 失效必须降级 ⛔ 反向(三约束②):仪表盘没起/取不到/字段缺 ⇒ 一律显示「读不到」,
#   ⛔ 显示 0% 也 ⛔ 静默跳过 —— 「额度充裕」与「没测到」在屏幕上必须长得不一样。
CHANNEL_QUOTA_WARN="${LAIXIN_CHANNEL_QUOTA_WARN:-80}"
channel_quota_verdict(){
  local url="${LAIXIN_USAGE_API:-http://127.0.0.1:8763/api/usage}"
  # 🔴 **两种失效必须可分辨**(2026-08-22 实撞):首版超时 3s,而该 API **同步去拉两个账号的官方
  #   额度、走代理,实测 7.16s** ⇒ 稳定超时,输出恒为「读不到」—— 与「仪表盘根本没起」**同一句话**,
  #   于是「服务好好的只是慢」被读成「服务没了」,查错方向当场跑偏。
  #   ⇒ 先用 2s 探静态页判**服务在不在**(它不触发上游拉取,快),再用长超时拉 API 判**数据取不取得到**。
  local probe_url="${LAIXIN_USAGE_PROBE:-${url%/api/usage}/}" alive="" raw=""
  alive="$(curl -s -m 2 -o /dev/null -w '%{http_code}' "$probe_url" 2>/dev/null || true)"
  if [ "$alive" != "200" ]; then
    echo "  ℹ️ 通道额度:用量仪表盘**未在监听**($probe_url,探活 2s 返回 ${alive:-无响应})⇒ 不适用(⛔ 读成额度充裕;起它:01A 项目包 cc-usage-monitor/monitor.py)"
    return 0
  fi
  raw="$(curl -s -m "${LAIXIN_USAGE_TIMEOUT:-15}" "$url" 2>/dev/null || true)"
  if [ -z "$raw" ]; then
    echo "  ℹ️ 通道额度:仪表盘**在跑但额度拉取超时**(>${LAIXIN_USAGE_TIMEOUT:-15}s;它同步拉上游官方接口,慢属常见)⇒ 本次不适用(⛔ 读成额度充裕;稍后重跑或直接看 $probe_url)"
    return 0
  fi
  local out; out="$(printf '%s' "$raw" | CQ_WARN="$CHANNEL_QUOTA_WARN" CQ_SWARN="${LAIXIN_CHANNEL_SESSION_WARN:-90}" CQ_LAUNCHER="$CLAUDE_LAUNCHER" python3 -c '
import json,sys,os,glob
warn=int(os.environ.get("CQ_WARN","80")); launcher=os.environ.get("CQ_LAUNCHER","")
def out(x): print(x)
try: d=json.load(sys.stdin)
except Exception:
    out("  INFO 通道额度:仪表盘响应不是 JSON => 不适用(不得读成额度充裕)"); sys.exit(0)
bymail={}
for a in d.get("official_accounts") or []:
    m=a.get("account")
    lim={l.get("kind"):l for l in ((a.get("data") or {}).get("limits") or [])}
    w=lim.get("weekly_all") or {}
    # ⚠️ 只看周额度会漏掉**5 小时窗口(session)耗尽**这一族:它同样让席位当场停摆,而且比周额度
    #   更容易撞(一轮密集派工就能打满),重置也快。⇒ 两个都取,分别给阈值。
    sess=lim.get("session") or {}
    if m and w.get("percent") is not None:
        bymail[m]=(w.get("percent"), (w.get("resets_at") or "")[:16], sess.get("percent"), (sess.get("resets_at") or "")[:16])
if not bymail:
    out("  INFO 通道额度:仪表盘未返回任何账号额度 => 不适用(不得读成额度充裕)"); sys.exit(0)
# 通道->账号取 <配置目录>/.claude.json 的 oauthAccount.emailAddress(不用 Keychain:要授权,无人值守会挂)
# 同一账号可能绑多个配置目录(遗留空壳目录实测存在)=> 按账号去重,显示 launcher 指向的那个
seen={}
for cfg in sorted(glob.glob(os.path.expanduser("~/.claude*"))):
    if not os.path.isdir(cfg): continue
    base=os.path.basename(cfg)
    try: mail=(json.load(open(os.path.join(cfg,".claude.json"))).get("oauthAccount") or {}).get("emailAddress")
    except Exception: mail=None
    if not mail or mail not in bymail: continue
    cur=(launcher=="claude" and base==".claude-official") or (launcher=="claude-b" and base==".claude-b") or (launcher=="claude" and base==".claude")
    if mail in seen:
        old=seen[mail]
        seen[mail]=(base if cur else old[0], old[1]+1, old[2] or cur)
    else:
        seen[mail]=(base,1,cur)
if not seen:
    out("  INFO 通道额度:配置目录与仪表盘账号对不上 => 不适用(不得读成额度充裕)"); sys.exit(0)
cur_row=None
for mail,(base,ndir,is_cur) in sorted(seen.items(), key=lambda kv: (not kv[1][2], kv[1][0])):
    pct,reset,spct,sreset=bymail[mail]
    extra=("(+%d 个同账号目录)" % (ndir-1)) if ndir>1 else ""
    tag="  <= 当前 CLAUDE_LAUNCHER 指向" if is_cur else ""
    if is_cur: cur_row=(base,pct,spct)
    sess_txt=("  5h窗口 %s%%(重置 %s)" % (spct, sreset[-5:] or "?")) if spct is not None else "  5h窗口 读不到"
    out("  通道 %s%s(%s):周额度 %s%%  重置 %s%s%s" % (base, extra, mail, pct, reset or "?", sess_txt, tag))
if cur_row is None:
    out("  INFO 通道额度:CLAUDE_LAUNCHER=%s 未匹配到任何通道 => 到线判据不适用(不得读成额度充裕)" % (launcher or "?")); sys.exit(0)
swarn=int(os.environ.get("CQ_SWARN","90"))
others=[(b,bymail[m][0]) for m,(b,n,c) in seen.items() if not c]
tip=(";另一通道 %s 周额度仅 %s%%" % (others[0][0], others[0][1])) if others else ""
hit=False
if cur_row[1] >= warn:
    out("WARN 当前通道 %s 周额度已 %s%%(>=%s%%)——该按「CC 双账号切换剧本」轮换了%s" % (cur_row[0], cur_row[1], warn, tip)); hit=True
# 5h 窗口单独判:它打满时**席位当场停摆**,但几小时后自愈 ⇒ 措辞要说清「等重置 or 换通道」,
# ⛔ 与周额度混成一条(两者的处置完全不同:一个换通道,一个等一会儿)。
if cur_row[2] is not None and cur_row[2] >= swarn:
    out("WARN 当前通道 %s 的 5 小时窗口已 %s%%(>=%s%%)——**这一族几小时后自愈**,处置=等重置或临时换通道,⛔ 与周额度混判" % (cur_row[0], cur_row[2], swarn)); hit=True
if not hit:
    out("  OK 当前通道额度未到线(周<%s%% 且 5h窗口<%s%%)" % (warn, swarn))
')"
  local line
  while IFS= read -r line; do
    case "$line" in
      "WARN "*) wrn "${line#WARN }" ;;
      "  OK "*) ok "${line#  OK }" ;;
      "  INFO "*) printf '  ℹ️ %s\n' "${line#  INFO }" ;;
      *) printf '%s\n' "$line" ;;
    esac
  done <<< "$out"
  return 0
}

# 防撞:两个派工窗口同时动 lane 会把 Codex 上下文搞乱(2026-08-13 实际险些发生,靠人工提醒才没撞)
check_rival_dispatch() {
  rival_holds_dispatch || return 0
  echo "⚠️ 派工权由 [$(lock_holder)] 持有,心跳 $(lock_age) 秒前——它正在动 lane。" >&2
  echo "   绝不允许两个派工窗口同时活着:先让它收工(或确认它已停 $((LOCK_FRESH/60)) 分钟以上),再重试。" >&2
  echo "   确认无误可加 --force-rival 强行起窗。" >&2
  return 1
}

cmd_dispatch() {
  local dir="$HOME" force="" nocheck=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --dir)   dir="${2:?--dir 需要路径}"; shift 2 ;;
      --fresh) force=1; shift ;;
      --force-rival) nocheck=1; shift ;;
      *) die "未知参数:$1" ;;
    esac
  done
  # 🔴 起窗时**实时解析**引擎(2026-08-22 实撞:看门狗循环内存攥着切换前的值,切回后仍按旧引擎重起)——
  #   看门狗/boot 链在本进程内调本函数,只有这里重读,切引擎才不用重起循环。
  read -r DISPATCH_ENGINE DISPATCH_ENGINE_REQ <<< "$(dispatch_engine_resolve)"
  # #67:引擎校验在动窗口**之前**(同 #60① 一课:值打错不该留下半个死窗口/半个被杀的旧窗口)
  case "$DISPATCH_ENGINE" in claude|kimi) : ;; *) die "未知派工引擎:$DISPATCH_ENGINE(只接受 claude|kimi;dispatch_engine_resolve 失守)" ;; esac
  # 无效请求点名(⛔ 静默忽略,也 ⛔ die):die 会让看门狗/boot 链的无人值守重生整条失效——一个过期的开关文件
  #   不该有权停掉自愈;静默则让「请求 codex 得到 claude」在看板上同形。⇒ 照常按 claude 起,但当面说、上看板。
  if [ "$DISPATCH_ENGINE_REQ" != "$DISPATCH_ENGINE" ]; then
    echo "⚠️ 派工引擎请求「${DISPATCH_ENGINE_REQ}」无效(只有 claude 默认/kimi 可选顶班;codex 已于 2026-08-22 废除),按 claude 起窗;清理:rm ~/.laixin-lane-switch/dispatch-engine / unset LAIXIN_DISPATCH_ENGINE"
    board "$(caller_src)" "⚠️ 派工引擎请求「${DISPATCH_ENGINE_REQ}」无效(只有 claude 默认/kimi 可选;codex 已废除)——按 claude 起窗"
  fi
  ensure_session
  if [ -z "$nocheck" ] && ! check_rival_dispatch; then
    die "起窗中止——绝不允许两个派工窗口同时活着。先确认那些窗口已收工,或确认它们不是派工窗口后加 --force-rival 重试"
  fi
  if win_exists "$DISPATCH_WIN"; then
    [ -n "$force" ] || { echo "$DISPATCH_WIN 已存在(换全新上下文用 --fresh)"; return 0; }
    tmux kill-window -t "$SESSION:$DISPATCH_WIN"; sleep 0.3
  fi
  local _cdp_port="$DISPATCH_CDP_PORT"
  local _brief="$DISPATCH_BRIEF"
  if [ "$DISPATCH_ENGINE" = "claude" ]; then
  local deny; deny="$(printf '"%s" ' "${DISPATCH_DENY[@]}")"
  ensure_headless_settings
  # 起窗+就绪等待,撞 Claude 自更新时定向重试一次(复盘页#20c):08-19 05:07 实撞——起窗恰逢
  # claude.exe 替换瞬间(时间戳 05:08,窗口以秒计),包装器 fail-closed 留空 shell,而报错落在
  # 正退场的交班窗口里无人看见。该因**天然瞬时**,等 20s 重试一次不属「同因重试同死」;
  # 其余启动失败照旧不自动重试(die 大声报,看门狗 wd_alive 修复后下一拍也会兜)。
  local _attempt
  for _attempt in 1 2; do
    tmux new-window -t "$SESSION" -n "$DISPATCH_WIN" -c "$dir" 2>/dev/null || true
    sleep 0.5
    tmux send-keys -t "$SESSION:$DISPATCH_WIN" "BU_NAME=\"dispatch\" BU_CDP_URL=\"http://127.0.0.1:$_cdp_port\" $CLAUDE_LAUNCHER -n \"$DISPATCH_WIN\" --model $DISPATCH_MODEL --permission-mode auto --settings \"$HEADLESS_SETTINGS\" --disallowedTools $deny" C-m
    if vwait_ready "$DISPATCH_WIN" "$dir"; then break; fi
    if [ "$_attempt" = 1 ] && tmux capture-pane -p -t "$SESSION:$DISPATCH_WIN" 2>/dev/null | grep -q "Claude Code CLI not found"; then
      board "$(caller_src)" "⚠️ dispatch 起窗撞上 Claude 自更新二进制替换窗口(#20c),20s 后定向重试一次"
      tmux kill-window -t "$SESSION:$DISPATCH_WIN" 2>/dev/null || true
      sleep 20
      continue
    fi
    die "$DISPATCH_WIN 启动超时。查看:laixin-lane peek-d 40"
  done
  else
  # ── kimi 引擎(**可选顶班**,claude 额度耗尽时;2026-08-22 定案。codex 派工分支同日废除——它跑通的
  #    非 claude 通信形态 relay-msg/dmsg 由 kimi 沿用):起窗形态与 lane 的 C 轨同一份(kimi_launch_cmd)。
  # ⛔ 用 claude 那条 #20c 定向重试:那个因是「claude 二进制被自更新替换」,kimi 没有这个因。
  # ⛔ 用 --settings/--disallowedTools:kimi 无等价物 ⇒ DISPATCH_DENY 的 git push 工具层锁失效,改由指令明写 + git 层 pre-push 兜底。
  # #68:kimi 对每个新工作目录弹 `Trust this folder?`,两个选项都是坑(不信任=直接退出)
  # ⇒ **起窗前预写信任记录**,⛔ 起完再想办法点按钮——托管窗口无人可点。
  _brief="$DISPATCH_BRIEF_KIMI"
  # 🔴 创始人 2026-08-22 19:5x:「派工窗口如果换成 kimi 的时候,relay 就一定要是 claude」——机器形态:kimi 派工席起窗前
  #   常驻 claude 中继必须在班,不在就在此**自动拉起**(cmd_relay --fresh --resurrect:系统按拓扑要求拉起/换掉死窗口,
  #   ⛔ 人手开第二中继那种形态——双中继守卫在常态拓扑 outside=2 下恒拦,故走 --resurrect 豁免;起窗即开托管,看门狗随即保活)。
  #   拉不起 ⇒ die(大声,含看门狗重生路径):宁可派工席空着被每拍报「重起失败」,也 ⛔ 起一个出站无代发方的 kimi 派工席
  #   (那种失败只在它第一次 relay-msg 时才露出,而此前一切看着正常)。子 shell 隔离收码(#44:cmd_relay 树里有 die)。
  if ! relay_alive; then
    local _rr_rc=0 _rr_out=""
    _rr_out="$(cmd_relay --fresh --resurrect 2>&1)" || _rr_rc=$?
    [ "$_rr_rc" -eq 0 ] || die "kimi 派工席要求常驻 claude 中继在班(创始人 2026-08-22 令),自动拉起失败(rc=${_rr_rc}):$(tail -1 <<< "$_rr_out" | cut -c1-160)——先 laixin-lane relay 起中继再起派工窗口"
    board "$(caller_src)" "kimi 派工席起窗前已自动拉起常驻 claude 中继 relay(创始人令:派工席=kimi 时中继一律 claude;托管已开)"
  fi
  kimi_trust_prewrite "$dir" || die "$DISPATCH_WIN 起窗中止:kimi 信任记录预写失败(见上方告警)"
  tmux new-window -t "$SESSION" -n "$DISPATCH_WIN" -c "$dir" 2>/dev/null || true
  sleep 0.5
  tmux send-keys -t "$SESSION:$DISPATCH_WIN" "$(kimi_launch_cmd "dispatch" "$_cdp_port")" C-m
  vwait_ready_kimi "$DISPATCH_WIN" || die "$DISPATCH_WIN 启动超时(90s 未见 kimi 就绪状态栏)。查看:laixin-lane peek-d 40"
  fi
  sleep 1
  printf '%s' "$_brief" | tmux load-buffer -b laixin-dmsg -
  tmux paste-buffer -p -b laixin-dmsg -t "$SESSION:$DISPATCH_WIN"
  tmux delete-buffer -b laixin-dmsg
  sleep 0.5
  tmux send-keys -t "$SESSION:$DISPATCH_WIN" C-m
  # #37:回读复核接管指令已提交(后台跑,未提交先补 Enter、仍失败大声上看板;显式脱离 fd 防拖 $( ) 读)
  ( confirm_briefed "$DISPATCH_WIN" "dispatch" "$DISPATCH_ENGINE" ) >/dev/null 2>&1 &
  printf '%s %s\n' "$DISPATCH_WIN" "$(date +%s)" > "$DISPATCH_LOCK"   # 起窗即认领派工权
  board "$(caller_src)" "起派工窗口 $DISPATCH_WIN(全新上下文,已派接管指令,派工权已认领;引擎=$DISPATCH_ENGINE)"
  ev_alive || { cmd_events stop >/dev/null 2>&1 || true; cmd_events start >/dev/null 2>&1 || true; }
  # 起窗验尸(复盘页#20b,lanes #11-③ 同款):就绪判定可能被过渡画面骗过,15s 后回头核
  # pane 里跑的真是 claude——掉回登录 shell 即大声告警,⛔ 自动重试(非瞬时因,人工看现场)。
  ( sleep 15
    _pc="$(tmux display-message -p -t "$SESSION:$DISPATCH_WIN" '#{pane_current_command}' 2>/dev/null || echo 无窗口)"
    if [ "$_pc" = "$(basename "${SHELL:-/bin/zsh}")" ] || [ "$_pc" = "无窗口" ]; then
      _tail="$(tmux capture-pane -p -t "$SESSION:$DISPATCH_WIN" 2>/dev/null | grep -v '^[[:space:]]*$' | tail -2 | tr '\n' ' ' | cut -c1-160 || true)"
      board "$(caller_src)" "⚠️ dispatch 起窗验尸失败(15s 后 pane=${_pc},已掉回 shell)——脚本报过已起,现场没起;末行:${_tail}"
    fi
  ) >/dev/null 2>&1 &   # 显式脱离 stdout/stderr:#44 后 wd_loop 用命令替换收本函数输出,后台块握着继承的 fd 会把 $( ) 读拖到 15s 后才返回
  # #50/#57:守卫状态如实回显——被 --force-rival 跳过时 ⛔ 让输出读起来像「核过了」
  local _guard="双派工守卫已核:无对手"
  [ -n "$nocheck" ] && _guard="双派工守卫被 --force-rival 跳过(未核,风险自担)"
  echo "$DISPATCH_WIN 已起并接管(引擎=$DISPATCH_ENGINE;${_guard};15s 验尸+接管回读复核已挂后台,异常上看板)。复核:laixin-lane peek-d 30"
  # ⚠️ `[ ] && echo` 作为**函数最后一条语句**:条件为假时函数退出码=1 ⇒ wd_loop/resurrect 收码时
  #    会把一次正常的 claude 起窗读成失败(本仓 grep 零命中击穿函数同族)。必须 || true 兜底。
  if [ "$DISPATCH_ENGINE" = "kimi" ]; then
    echo "⚠️ kimi 引擎(顶班形态):出站需对方判断的消息走 laixin-lane relay-msg(中继代发);DISPATCH_DENY 的 git push 工具层锁**不生效**,已在派单指令里明写禁令(git 层 pre-push 兜底见 doctor §6);ctx 看其 TUI 底栏 context%(K3 窗口 1M)。"
  fi
  return 0
}

# ── 交班形态判据(2026-08-22 实撞后立)──────────────────────────────────────────────
# 失败样本:方案窗口第二十任交班当轮,把**同账号正常交班**办成了「2 个 CC 账号切换的交班」
#   (创始人当面纠正「把正常交班搞成了 2 个 CC 账号切换的交班」);连锁:relay 据此报了一条
#   「即将静默发生的断链」告警,前提为假,10 分钟后撤回。
# 🔑 **根因不在人,在卡**:当日新落的《跨账号切换剧本》只写了「怎么切」,**没写「什么时候才算在切」**
#   ⇒ 一张只讲 how 不讲 when 的卡,读者看见就会想用;而「这次是不是跨账号交班」当时**没有任何
#   可执行判据**,只能靠推定。二十任的认账一针见血:**「规则在案」≠「规则适用于当下」**。
# ⇒ 本命令把那个判断变成**一个能跑的动作**:比对两个会话的配置目录(=账号所在通道)。
#   ⚠️ 继任**尚未起窗时判不了** —— 那种情况判据只能是「创始人明示」,本命令会如实说判不了,
#      ⛔ 猜一个答案(猜错的代价就是上面那次:整套跨账号附则被误用 + 一条假告警)。
channel_of(){  # <会话名> → stdout="<配置目录> <账号邮箱>";找不到退 1
  local want="$1" pid dir line
  while IFS=' ' read -r pid dir _; do
    [ -n "$pid" ] || continue
    for f in "$dir"/sessions/"$pid".json; do
      [ -f "$f" ] || continue
      if [ "$(python3 -c 'import json,sys
try: print((json.load(open(sys.argv[1])).get("name") or ""))
except Exception: print("")' "$f" 2>/dev/null)" = "$want" ]; then
        printf '%s %s\n' "$dir" "$(python3 -c 'import json,sys
try: print(((json.load(open(sys.argv[1])).get("oauthAccount") or {}).get("emailAddress")) or "账号未知")
except Exception: print("账号未知")' "$dir/.claude.json" 2>/dev/null)"
        return 0
      fi
    done
  done <<< "$(session_seats)"
  return 1
}

cmd_channel_of(){
  local n="${1:-}"; [ -n "$n" ] || die "用法:laixin-lane channel-of <会话名>(如 pingxia-d8 / relay)"
  local r; r="$(channel_of "$n")" || die "找不到活会话:$n —— ⛔ 据此判断交班形态(「查不到」⛔「不在别的通道」);它可能还没起窗,或不是 claude 会话(codex/kimi 席位无配置目录)"
  printf '%s\n' "$r"
}

cmd_handover_mode(){  # <继任会话名> <前任会话名 | 前任通道目录>
  local succ="${1:-}" pred="${2:-}"
  [ -n "$succ" ] && [ -n "$pred" ] || die "用法:laixin-lane handover-mode <继任会话名> <前任会话名 | 前任通道目录>
   ⚠️ 两个都要显式给 —— ⛔ 让本命令去猜「前任是谁」:猜错时它会给出一个**看起来确定**的答案,
      而交班形态判错的代价是整套跨账号附则被误用(2026-08-22 实撞)。
   📌 **前任常在继任起窗前就已关闭**(交班的常见顺序就是前任先关) ⇒ 那时第二参传**通道目录**:
      交班方在自己还活着时跑 laixin-lane channel-of <自己> 把通道写进交接包,继任照抄即可
      —— 两次调用都发生在各自活着的时候,⛔ 依赖两个窗口同时在线。"
  local a b da db
  a="$(channel_of "$succ")" || die "继任 $succ 查不到活会话 ⇒ **判不了**(它可能还没起窗)。
   此时唯一判据=**创始人明示**本次是同账号还是跨账号;⛔ 由交班方自行推定(实撞:推错 ⇒ 跨账号附则被误用 + relay 一条假告警)。"
  case "$pred" in
    /*) b="$pred (交接包记录值)" ;;                      # 直接给通道目录:前任已关闭时的正路
    *)  b="$(channel_of "$pred")" || die "前任 $pred 查不到活会话 ⇒ 判不了(⛔ 猜)。
   📌 前任若已关闭,改传**通道目录**(交接包里应有;取法=交班方生前跑 laixin-lane channel-of <自己>):
      laixin-lane handover-mode $succ /Users/pingxia/.claude-b" ;;
  esac
  da="${a%% *}"; db="${b%% *}"
  printf '  继任 %s:%s\n  前任 %s:%s\n' "$succ" "$a" "$pred" "$b"
  if [ "$da" = "$db" ]; then
    printf '  ✅ **同账号正常交班** —— 交班卡原六步一字不改,**跨账号附则整卡 ⛔ 适用**\n'
    return 0
  fi
  printf '  🔁 **跨账号交班** —— 交班卡第 4/5 步按附则替换(落盘 + 一句话路径),relay 归属另判\n'
  return 0
}

cmd_handover_audit(){  # #108 全量清单:doctor 只逐条报近几天的,历史债在这里看全(⛔ 让它只存在于总数里)
  local rp; rp="$(ls "$HOME"/Obsidian/项目入口/laixin开发流水线/知识库/wiki/运行复盘与优化推动-*.md 2>/dev/null | sort | tail -1)"
  [ -n "$rp" ] || die "复盘页不可读"
  echo "== 交班条已见而复盘页无「收班盘点」节的全量清单(交班卡第 6 步漏做) =="
  echo "   复盘页:$rp"
  local out; out="$(handover_unpaired "$BOARD" "$rp")"
  if [ -z "$out" ]; then echo "   ✅ 全部配对,零缺漏"; return 0; fi
  printf '%s\n' "$out" | sed 's/^/   /'
  printf '   —— 合计 %s 条 ——\n' "$(printf '%s' "$out" | grep -c '任' || true)"
  echo "   补法:复盘页追加「<角色><任次>收班盘点」节(单一入口 ⛔ 散落快照);盘点内容照收班卡形态——"
  echo "   只挑真实发生过的摩擦(失败样本→候选优化),分流三去向:可机器化→11B 队列 / 规则类→当轮落卡 / 要创始人拍的→专场攒。"
}

cmd_peekd() { tmux capture-pane -p -t "$SESSION:$DISPATCH_WIN" -S "-${1:-30}"; }

# ================= 中继窗口托管(#32,2026-08-19 创始人直裁) =================
# 解决的失败(当日 P0-1 整机重启实证):dispatch 由 boot 链自动重生零人工,而**中继窗口断档**
# 只能等创始人开窗凭库接班(08:47 重启 → 09:01 接班,约 14 分钟且依赖人在场)。
# 「窗口存活依赖人」在 dispatch 上已被看门狗消除,本节消除中继这一侧。形态照抄 cmd_dispatch。
RELAY_WIN="relay"
# CDP 通道:段位=创始人 2026-08-17 裁定 9230+(dispatch=9230,lane=9231/9232,lane 派生兜底 9233-9292,
# verify=9300-9999)⇒ relay 取 9299:在 lane 派生上界之上、verify 段起点之下,与现有全部固定/派生端口零交集。
# 本批只固定端口,⛔ 不做「按段分配」机制(后续批)。
RELAY_CDP_PORT="${LAIXIN_RELAY_CDP_PORT:-9299}"
# 显式启用标记:**本族全部保活行为的总闸门**。laixin-lane relay 起窗时写、relay-down 时清。
# 为什么要它(2026-08-19 落地当日的硬约束):现任中继是创始人**手开**的窗口,代码一装若立刻让
# 看门狗自动拉起 relay,就会当场出现双中继。⇒ 标记不在 = 完全惰性(零告警零拉起零错误),
# 直到有人手跑一次 laixin-lane relay,托管才生效。失效方向也对:标记丢了是「不托管」(退回今天的现状),
# ⛔ 不是「乱拉窗口」——检查器三约束②(失效必须降级,⛔ 反向)。
RELAY_ENABLED="${LAIXIN_RELAY_ENABLED:-$HOME/.laixin-relay.enabled}"
# deny 按中继职责裁剪(照 VERIFY_DENY 剪):中继**不派工**(send/fresh/up/down/claim 是派工的定义性动作)、
# **不合并不推送**(merge/push/reset --hard)。⛔ 不禁只读 git 与 verify 族——中继的活就是核库
# (git log/show/diff 复现 commit 与改动面),禁掉等于禁掉它的本职。
RELAY_DENY=(
  "Bash(git push*)" "Bash(git merge*)" "Bash(git reset --hard*)"
  "Bash(laixin-lane send*)" "Bash(laixin-lane fresh*)" "Bash(laixin-lane up*)" "Bash(laixin-lane down*)"
  "Bash(laixin-lane claim*)"
  # 2026-08-19 创始人明令补全(#67 代理报出三项,创始人窗口 b7 逐一核全部子命令后扩到十三项):
  # 原八项只禁「动 lane」,而 relay 实际还能 `dispatch --fresh` **杀掉并重起派工窗口** —— 比注入一条消息重得多;
  # 同理还能 halt 整条流水线、release 换代、停 watchdog/events。⛔ 只补代理报的那三项(那正是判据比缺陷窄)。
  # ⚠️ relay-msg 有意 ⛔ 入列:它有 whoami_window 机器闸(只允许 dispatch 调),且绊线钉死它不在本列表里。
  # ⚠️ ⛔ 用 "laixin-lane relay*" 通配:会误伤 relay-msg;起自己(`relay`)风险低(等于自杀,看门狗会处理)故不禁。
  "Bash(laixin-lane dispatch*)"                              # 杀重起派工窗口
  "Bash(laixin-lane halt*)" "Bash(laixin-lane resurrect*)"   # 暂停/恢复整条流水线
  "Bash(laixin-lane release*)"                               # 换代
  "Bash(laixin-lane watchdog*)" "Bash(laixin-lane events*)"  # 停守护循环
  "Bash(laixin-lane ev-loop*)" "Bash(laixin-lane wd-loop*)"  # 循环本体
  "Bash(laixin-lane verify*)" "Bash(laixin-lane vdown*)"     # 起/收验收窗(dispatch 的活)
  "Bash(laixin-lane relay-down*)"                            # 关自己
  "Bash(laixin-lane install-*)"                              # 装 boot 链/备份
  "Bash(laixin-lane evid-gc*)"                               # 清证据
)

relay_enabled() { [ -f "$RELAY_ENABLED" ]; }

relay_alive() {
  win_exists "$RELAY_WIN" || return 1
  case "$(pane_cmd "$RELAY_WIN")" in
    NONE) return 0 ;;   # ⚠️ 查询**没拿到答案**(窗口在 win_exists 与本次查询之间消失,或 tmux 未响应)
                        #    ⇒ **存疑不动**,⛔ 判死 —— 三约束②「失效必须降级 ⛔ 反向」。
                        #    ⚖️ 同一条纪律在本文件的 RELAY_ENABLED 总闸门上是做对的(注释逐字
                        #    「标记丢了是不托管…⛔ 不是乱拉窗口」),而此处曾做反:查询不可靠时
                        #    去**杀掉一个活着的席位**。(relay 第十二任指出该对照)
    node|claude|claude.exe) return 0 ;;   # claude 进程还在
    *) return 1 ;;                        # 掉回 shell = 已死
  esac
}

# 防撞:绝不允许两个中继同时活着。
# ⛔ 这里**不造心跳锁**:锁要有人续期才不是假绿,而中继没有 send 那样的机器可观察「定义性动作」
# 可挂心跳 ⇒ 无人续期的锁 30 分钟后静默失效,恰好在「该拦的时候不拦」——三约束②反向生效族。
# 改用两个真实可观察的事实:①tmux 内 relay 窗口在不在(cmd_relay 自己查);②tmux 外活跃 claude
# 会话数 outside_sessions。基线=1(方案窗口常驻 tmux 外)⇒ >1 说明多出手开的窗口,**很可能就是
# 手开的中继**(2026-08-19 现任 pingxia-1a 正是此形态,实测 outside=2)⇒ 拦下,留 --force-rival 逃生口。
check_rival_relay() {
  local n; n="$(outside_sessions)"
  if [ "${n:-0}" -le 1 ]; then return 0; fi
  echo "⚠️ tmux 外有 $n 个活跃 claude 会话(基线 1=方案窗口)——多出来的很可能就是**手开的中继窗口**。" >&2
  echo "   绝不允许两个中继同时活着:先让手开的中继把班交给本窗口并退场,再重试。" >&2
  echo "   确认那些会话都不是中继,可加 --force-rival 强行起窗。" >&2
  return 1
}

